# tuxwall dashboard site - reverse proxy for the Python API backend.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    # Win the default slot on the LAN IPs too, so the Certbot catch-all
    # in the homeassistant site doesn't 404 bare-IP dashboard requests.
    listen 192.168.1.1:80 default_server;
    listen 10.0.0.1:80 default_server;
    listen [fd00:1::1]:80 default_server;

    root /var/www/html;
    index index.html;

    server_name _;
    server_tokens off;

    # opencode agent SSE stream (/api/agent/events) — must stay open and
    # unbuffered indefinitely: the agent can sit idle for minutes while a
    # permission approval is pending, and default proxy_read_timeout (60s)
    # kills the stream and drops events mid-turn.
    location = /api/agent/events {
        allow 127.0.0.1;
        allow ::1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;

        proxy_pass http://127.0.0.1:8008;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Dashboard API -> Python backend
    location /api/ {
        allow 127.0.0.1;
        allow ::1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;

        proxy_pass http://127.0.0.1:8008;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Block access to Python source files
    location ~ \.py$ {
        return 404;
    }

    location / {
        allow 127.0.0.1;
        allow ::1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        error_page 403 =200 @empty_response;
        deny all;
        try_files $uri $uri/ =404;
    }

    location @empty_response {
        return 200 '';
        default_type text/html;
    }
}
