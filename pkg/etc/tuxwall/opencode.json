{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "small_model": "opencode/ling-3.0-flash-free",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "systemctl status *": "allow",
      "systemctl is-active *": "allow",
      "journalctl *": "allow",
      "ufw status*": "allow",
      "ip *": "allow",
      "ss *": "allow",
      "cat /var/log/*": "allow",
      "tail *": "allow",
      "head *": "allow",
      "grep *": "allow",
      "ls *": "allow",
      "df *": "allow",
      "free *": "allow",
      "uptime": "allow",
      "unbound-control status": "allow",
      "unbound-control stats_noreset": "allow",
      "cscli decisions list": "allow",
      "cscli alerts list": "allow",
      "wg show": "allow"
    }
  }
}
