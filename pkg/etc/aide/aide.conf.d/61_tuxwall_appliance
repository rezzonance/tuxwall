# Tuxwall appliance exclusions - live databases, regenerated lists, log churn
# and ephemeral state that can never hash consistently. Security-relevant
# paths (system binaries, /etc, /var/www/html dashboard code) stay watched.
# Evidence: nightly aide.log churn review 2026-10-03.

# Unifi controller live database (WiredTiger journals churn constantly)
!/var/lib/unifi/db
!/var/lib/unifi/logs

# Regenerated by tuxwall on every apply/update - structural churn, not drift
!/var/lib/unbound
!/var/lib/tuxwall
!/var/lib/zeek
!/var/lib/suricata
!/var/lib/crowdsec/data
!/var/lib/vnstat
!/var/lib/kea
!/var/lib/aide
!/var/lib/private

# Zeek cluster spool + rotated log archives
!/opt/zeek/spool
!/opt/zeek/logs

# Growing sensor / dashboard logs (access + eve.json rotate too fast to hash)
!/var/log/suricata
!/var/www/html/logs

# Ephemeral runtime + dev state
!/tmp
!/run/snapd
!/home/jeff/.cache
!/home/jeff/.local
