[Unit]
Description=TuxWall idempotent NAT masquerade setup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/tuxwall-nat-ensure
RemainAfterExit=yes
# the script may wait up to 90 s for the WAN default route at boot
TimeoutStartSec=150

[Install]
WantedBy=multi-user.target
