# TuxWall first-boot setup wizard on a console (tty1, ttyS0, ...).
# Shipped by the .deb but NOT enabled by it: only the netinstaller / VM
# images enable instances (image/common/install-firstboot.sh), and it only
# acts while /etc/tuxwall/setup-pending exists. tuxwall-setup removes the
# flag and the instance links when the setup is completed.
[Unit]
Description=TuxWall first-boot setup on %I
Documentation=file:/usr/local/sbin/tuxwall-setup
ConditionPathExists=/dev/%I
# Starts once the boot is complete (cloud-init done) and takes the console
# over from its getty: Conflicts= + After= make systemd drop the getty's boot
# start job (or stop a running getty first). No pre-start "stop the getty":
# it raced the gettys' TTYVHangup and the wizard was killed by SIGHUP.
DefaultDependencies=no
Conflicts=getty@%i.service serial-getty@%i.service
After=getty@%i.service serial-getty@%i.service
After=multi-user.target cloud-final.service systemd-user-sessions.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
# Not a unit condition (the getty would stay stopped): tuxwall-setup exits
# at once when /etc/tuxwall/setup-pending is gone, then the getty comes back.
Environment=TUXWALL_SETUP_FIRSTBOOT=1
ExecStart=/usr/local/sbin/tuxwall-setup --console %I
ExecStopPost=-/bin/sh -c 'case "%I" in tty[0-9]*) u=getty@%I.service ;; *) u=serial-getty@%I.service ;; esac; /usr/bin/systemctl --no-block start "$u"'
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/%I
TTYReset=yes
TTYVHangup=yes
Restart=no

[Install]
WantedBy=multi-user.target
