#!/usr/bin/env bash
# tuxwall postinst: full provisioning of the dashboard on the target system.
set -euo pipefail

WWW=/var/www/html
STATE_DIR=/var/lib/tuxwall

# ── Step progress bar ─────────────────────────────────────────────────────
# Prints each step with a filled bar so the install shows visual progress:
#   [██████████░░░░░░░░░░░░░░░░] [6d/9] Enabling daily Suricata rule ...
# Pure block characters, no ANSI cursor tricks - renders identically on a
# terminal, in apt/dpkg logs, and under unattended-upgrades. Built with bash
# string appends (not tr) because tr is byte-oriented and mangles UTF-8.
STEP_TOTAL=12
STEP_NOW=0
step() {
  local label="$1" text="$2" width=24 i
  STEP_NOW=$((STEP_NOW + 1))
  local filled=$(( STEP_NOW * width / STEP_TOTAL ))
  (( filled > width )) && filled=$width
  local bar="" empty=""
  for ((i = 0; i < filled; i++)); do bar+="█"; done
  for ((i = filled; i < width; i++)); do empty+="░"; done
  printf '[%s%s] [%s/9] %s\n' "$bar" "$empty" "$label" "$text"
}

case "$1" in
  configure)

    step 1 "Creating state directory ($STATE_DIR)..."
    mkdir -p "$STATE_DIR"
    chmod 755 "$STATE_DIR"

    step 2 "Ensuring /etc/tuxwall exists..."
    mkdir -p /etc/tuxwall

    step 3 "Creating empty blocklist configs (so Unbound includes are valid)..."
    # Must live under /var/lib/unbound/ - Unbound's AppArmor profile only allows
    # it to read /etc/unbound/** and /var/lib/unbound/**
    mkdir -p /var/lib/unbound
    [[ -f /var/lib/unbound/blocklist.conf ]] || : > /var/lib/unbound/blocklist.conf
    if [[ ! -s /var/lib/unbound/client-bans.conf ]]; then
    cat > /var/lib/unbound/client-bans.conf <<'EOF'
# Managed by the tuxwall DHCP Clients page - DO NOT EDIT
server:
EOF
    fi

    step 4 "Wiring blocklists into Unbound..."
    cat > /etc/unbound/unbound.conf.d/99-blocklists.conf <<'EOF'
# Managed by the tuxwall Blocklists page - DO NOT EDIT
server:
    # lets unbound-control report rcode stats so the dashboard can show
    # blocked-query counts (NXDOMAIN answers)
    extended-statistics: yes
include: "/var/lib/unbound/blocklist.conf"
include: "/var/lib/unbound/client-bans.conf"
EOF

    # Universal unbound configs: install only when absent, never clobber
    # (same rule as router-dns.conf). Without these, a fresh install has no
    # control socket (every tuxwall hot-reload path fails), no DNSSEC
    # validation, no local domains, and no control-plane logging.
    for f in remote-control.conf root-auto-trust-anchor-file.conf \
             log-local-actions.conf 98-local-domains.conf; do
      if [[ ! -s "/etc/unbound/unbound.conf.d/$f" ]]; then
        cp "/usr/share/tuxwall/unbound/$f" "/etc/unbound/unbound.conf.d/$f"
        echo "   installed $f (was absent)"
      fi
    done

    # Resilience drop-in: unbound must never hit systemd's start limit.
    # A transient bind failure (optional interface address absent at
    # restart) must self-heal when the address returns, not wedge DNS
    # permanently (observed live 2026-10-06: unplugged worknet link +
    # unattended-upgrades restart = LAN-wide DNS outage until manual
    # console recovery).
    if [[ ! -f /etc/systemd/system/unbound.service.d/tuxwall-resilience.conf ]]; then
      mkdir -p /etc/systemd/system/unbound.service.d
      cp /usr/share/tuxwall/unbound/tuxwall-resilience.conf \
         /etc/systemd/system/unbound.service.d/tuxwall-resilience.conf
      systemctl daemon-reload || true
      echo "   installed unbound start-limit resilience override"
    fi

    # Basic working Kea DHCP + radvd (IPv6 RA) configs for fresh installs -
    # the same install-if-absent rule as router-dns.conf and the universal
    # unbound configs. Both detect the LAN interface; the dashboard's DHCP
    # page manages Kea thereafter via its API. Reference versions of every
    # config live on tuxwall.org/configs.
    LAN_IF=""; LAN_IP=""; LAN_SUBNET=""
    WAN_IF="$(ip route show default 2>/dev/null | awk '{print $5; exit}')"
    while read -r _if _ip; do
      [[ -n "$LAN_IF" || "$_if" == "$WAN_IF" || "$_if" == "wg0" ]] && continue
      case "$_ip" in
        192.168.*|10.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*) LAN_IF="$_if"; LAN_IP="$_ip" ;;
      esac
    done < <(ip -4 -o addr show 2>/dev/null | awk '{print $2, $4}')
    if [[ -n "$LAN_IF" && -n "$LAN_IP" ]]; then
      LAN_SUBNET="$(python3 -c "import ipaddress; print(ipaddress.ip_network('${LAN_IP}', strict=False))" 2>/dev/null || true)"
    fi

    if [[ -n "$LAN_SUBNET" && ! -s /etc/kea/kea-dhcp4.conf ]]; then
      _base="${LAN_SUBNET%/*}"; _base="${_base%.*}"
      _mask="$(python3 -c "import ipaddress; print(ipaddress.ip_network('${LAN_SUBNET}').netmask)" 2>/dev/null || echo 255.255.255.0)"
      _netip="${LAN_IP%/*}"
      TMP="$(mktemp)"
      cat > "$TMP" <<KEA
{
  "Dhcp4": {
    "interfaces-config": {
      "interfaces": [ "$LAN_IF" ]
    },
    "valid-lifetime": 7200,
    "renew-timer": 3600,
    "rebind-timer": 6300,
    "lease-database": {
      "type": "memfile",
      "lfc-interval": 3600,
      "persist": true,
      "name": "/var/lib/kea/dhcp4.leases"
    },
    "control-socket": {
      "socket-type": "unix",
      "socket-address": "/run/kea/kea4-ctrl-socket"
    },
    "subnet4": [
      {
        "subnet": "$LAN_SUBNET",
        "pools": [ { "pool": "$_base.100 - $_base.199" } ],
        "option-data": [
          { "name": "domain-name-servers", "data": "$_netip" },
          { "name": "domain-name", "data": "housenetwork.site" },
          { "name": "routers", "data": "$_netip" },
          { "name": "subnet-mask", "data": "$_mask" }
        ]
      }
    ],
    "loggers": [
      { "name": "kea-dhcp4", "output_options": [ { "output": "syslog" } ], "severity": "INFO" }
    ]
  }
}
KEA
      # kea runs as the _kea/kea group and must be able to read its config
      _keagrp=""
      getent group _kea >/dev/null 2>&1 && _keagrp="_kea"
      getent group kea   >/dev/null 2>&1 && _keagrp="kea"
      if [[ -n "$_keagrp" ]]; then
        install -o root -g "$_keagrp" -m 0640 "$TMP" /etc/kea/kea-dhcp4.conf
      else
        install -o root -g root -m 0644 "$TMP" /etc/kea/kea-dhcp4.conf
      fi
      rm -f "$TMP"
      systemctl enable --now kea-dhcp4-server >/dev/null 2>&1 || true
      echo "   installed basic Kea DHCP config ($LAN_IF, $LAN_SUBNET, pool $_base.100-$_base.199)"
    fi

    if [[ -n "$LAN_IF" && ! -s /etc/radvd.conf ]]; then
      # Random RFC 4193 ULA /48 global id (stable once written - this file
      # is never regenerated after the first install)
      _gid="$(od -An -tx1 -N5 /dev/urandom 2>/dev/null | tr -d ' \n')"
      [[ ${#_gid} -ne 10 ]] && _gid="0011223344"
      _ula="fd${_gid:0:2}:${_gid:2:4}:${_gid:6:4}"
      TMP="$(mktemp)"
      cat > "$TMP" <<RADVD
interface $LAN_IF
{
    AdvSendAdvert on;
    MinRtrAdvInterval 30;
    MaxRtrAdvInterval 100;
    AdvManagedFlag off;
    AdvOtherConfigFlag off;
    prefix $_ula::/64
    {
        AdvOnLink on;
        AdvAutonomous on;
        AdvRouterAddr on;
    };
    RDNSS $_ula::1 { };
};
RADVD
      install -o root -g root -m 0644 "$TMP" /etc/radvd.conf
      rm -f "$TMP"
      systemctl enable --now radvd >/dev/null 2>&1 || true
      echo "   installed basic radvd config ($LAN_IF, ULA $_ula::/64)"
    fi

    # Router base: resolv.conf + forwarding + WAN NAT. Same guarded
    # style as everything above: each piece only lands when absent or
    # still in the stock state, never over an admin's deliberate change.
    # Without these a fresh install resolves (via the systemd-resolved
    # stub, bypassing unbound) but ROUTES nothing: no ip_forward, no NAT.
    WAN_IF="$(ip route show default 2>/dev/null | awk '{print $5; exit}')"

    # 1. Point the router's own resolver at unbound. Only rewrite when the
    #    file is still the stock resolved stub - a hand-pointed resolv.conf
    #    (upstream resolver, VPN DNS, etc.) is left untouched.
    if grep -qs '127.0.0.53' /etc/resolv.conf 2>/dev/null; then
      systemctl disable --now systemd-resolved >/dev/null 2>&1 || true
      systemctl disable systemd-resolved-varlink.socket \
                          systemd-resolved-monitor.socket >/dev/null 2>&1 || true
      printf 'nameserver 127.0.0.1\nnameserver ::1\nsearch home.arpa\n' \
        > /etc/resolv.conf
      echo "   systemd-resolved retired; resolv.conf -> unbound"
    fi

    # 2. Packet forwarding (v4 + v6): persisted and applied now.
    for k in net.ipv4.ip_forward net.ipv6.conf.all.forwarding; do
      if ! grep -qsE "^${k//./\.} *= *1" /etc/sysctl.d/99-tuxwall-router.conf 2>/dev/null; then
        echo "$k=1" >> /etc/sysctl.d/99-tuxwall-router.conf
      fi
      sysctl -w "$k=1" >/dev/null 2>&1 || true
    done
    # ufw's own sysctl handling must agree (ufw reloads apply these)
    grep -q '^net/ipv4/ip_forward' /etc/ufw/sysctl.conf 2>/dev/null || \
      echo 'net/ipv4/ip_forward=1' >> /etc/ufw/sysctl.conf
    grep -q '^net/ipv6/conf/all/forwarding' /etc/ufw/sysctl.conf 2>/dev/null || \
      echo 'net/ipv6/conf/all/forwarding=1' >> /etc/ufw/sysctl.conf
    # Route policy: keep ufw's default-deny routed posture and open
    # exactly one explicit route allow (LAN -> WAN), matching the
    # audited production design - never a blanket default allow routed.
    LAN_IF_D=""; WAN_IF_D="$WAN_IF"
    while read -r _if _ip; do
      [[ -n "$LAN_IF_D" || "$_if" == "$WAN_IF_D" || "$_if" == "wg0" ]] && continue
      case "$_ip" in
        192.168.*|10.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*) LAN_IF_D="$_if" ;;
      esac
    done < <(ip -4 -o addr show 2>/dev/null | awk '{print $2, $4}')
    if [[ -n "$LAN_IF_D" && -n "$WAN_IF_D" ]] \
       && ! ufw status 2>/dev/null | grep -q "on $LAN_IF_D.*out on $WAN_IF_D"; then
      ufw route allow in on "$LAN_IF_D" out on "$WAN_IF_D" \
        comment 'tuxwall: LAN -> WAN' >/dev/null 2>&1 || true
    fi
    echo "   IP forwarding enabled (v4 + v6, route: $LAN_IF_D -> $WAN_IF_D)"

    # 3. WAN masquerade, persisted the ufw-native way: a *nat block at the
    #    top of before.rules, which ufw itself applies on every boot and
    #    reload - survives reboots without any extra restore mechanism.
    if [[ -n "$WAN_IF" && -f /etc/ufw/before.rules ]] \
       && ! grep -q '^\*nat' /etc/ufw/before.rules; then
      cp -a /etc/ufw/before.rules /etc/ufw/before.rules.tuxwall-bak 2>/dev/null || true
      sed -i '1i\
*nat\
:POSTROUTING ACCEPT [0:0]\
-A POSTROUTING -o '"$WAN_IF"' -j MASQUERADE\
COMMIT\
' /etc/ufw/before.rules
      ufw reload >/dev/null 2>&1 || true
      echo "   WAN masquerade added to ufw before.rules ($WAN_IF)"
    fi

    # Forwarder for fresh installs only. Never touch an existing
    # router-dns.conf - it may hold a full hand-tuned server config.
    if ! grep -qs '^forward-zone:' /etc/unbound/unbound.conf.d/*.conf /etc/unbound/unbound.conf 2>/dev/null; then
      if [[ ! -s /etc/unbound/unbound.conf.d/router-dns.conf ]]; then
        echo "   No forward-zone configured - adding upstream forwarder (1.1.1.1/8.8.8.8)..."
        cat > /etc/unbound/unbound.conf.d/router-dns.conf <<'EOF'
server:
    do-not-query-localhost: no
forward-zone:
    name: "."
    forward-addr: 1.1.1.1
    forward-addr: 8.8.8.8
EOF
      else
        echo "   router-dns.conf already exists without forward-zone (recursive mode) - leaving untouched."
      fi
    fi
    unbound-checkconf || true
    systemctl restart unbound || true

    # Cache-bust dashboard assets on every package upgrade: browsers cache
    # ?v= URLs hard, so a fresh stamp guarantees the shipped JS/CSS is
    # actually fetched (setup.sh always did this; the .deb path did not).
    ASSET_V="$(date +%Y%m%d%H%M)"
    sed -i -E "s/\.(js|css)\?v=[-A-Za-z0-9._]+/.\1?v=${ASSET_V}/g" /var/www/html/index.html 2>/dev/null || true

    step 5 "Configuring nginx reverse proxy..."
    # Only manage the bundled vhost on fresh installs. If an enabled site
    # already serves the web root (custom router setup with SSL/vhosts),
    # leave nginx alone.
    if ! grep -rqs 'root /var/www/html' /etc/nginx/sites-enabled/; then
      if [[ ! -e /etc/nginx/sites-enabled/tuxwall ]]; then
        ln -sf /etc/nginx/sites-available/tuxwall /etc/nginx/sites-enabled/tuxwall
        rm -f /etc/nginx/sites-enabled/default
      fi
    else
      echo "   Existing site already serves /var/www/html - leaving nginx config untouched."
    fi
    if nginx -t >/dev/null 2>&1; then
      systemctl enable --now nginx >/dev/null 2>&1 || true
      systemctl reload nginx || true
    else
      echo "   WARNING: nginx config test failed - fix /etc/nginx/sites-available/tuxwall and reload nginx."
      nginx -t || true
    fi

    step 6 "Setting up firewall (ufw)..."
    # Only open SSH/HTTP when no such rule exists yet: upgrades must not
    # re-add a WAN-wide OpenSSH allow after the admin scoped it to LAN/VPN.
    ufw status 2>/dev/null | grep -q '22/tcp' || ufw allow OpenSSH >/dev/null 2>&1 || true
    ufw status 2>/dev/null | grep -q '80/tcp' || ufw allow 80/tcp >/dev/null 2>&1 || true
    # Retire any WAN-wide OpenSSH allow, but only when scoped SSH access
    # already exists (LAN/VPN interface rules) — upgrades must neither
    # re-add it nor lock out fresh installs that have nothing else.
    # Numbers shift on delete, so remove in descending order.
    if ufw status numbered 2>/dev/null | grep -qiE '22/tcp.* on '; then
      for n in $(ufw status numbered 2>/dev/null \
          | grep -i 'openssh' | grep -vi ' on ' \
          | grep -o '\[[ 0-9]*\]' | tr -d '[] ' | sort -rn); do
        ufw --force delete "$n" >/dev/null 2>&1 || true
      done
    fi
    if ! ufw status 2>/dev/null | grep -q 'Status: active'; then
      ufw --force enable >/dev/null 2>&1 || true
    fi
    # mDNS reflector firewall: allow UDP 5353 inbound on VPN + RFC1918 LAN
    # interfaces (never WAN — default deny covers it). Guarded so upgrades
    # never duplicate rules.
    for iface in $(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1 | grep -Ev '^(lo|ifb.*|docker.*|veth.*)$'); do
      case "$iface" in
        wg0) : ;;
        *) ip addr show "$iface" 2>/dev/null | grep -q 'inet 192\.168\.\|inet 10\.\|inet 172\.\(1[6-9]\|2[0-9]\|3[01]\)\.' || continue ;;
      esac
      ip route show default 2>/dev/null | grep -q "dev $iface" && continue
      ufw status 2>/dev/null | grep -q "5353.* on ${iface}" || \
        ufw allow in on "$iface" to any port 5353 proto udp comment 'mDNS reflector' >/dev/null 2>&1 || true
    done

    step 6b "Configuring Avahi mDNS reflector (Music Assistant discovery)..."
    # Best-effort: avahi-daemon is a hard Depends, but don't fail upgrades.
    if [[ -f /etc/avahi/avahi-daemon.conf ]]; then
      WAN_IF="$(ip route show default 2>/dev/null | awk '{print $5}' | head -n1)"
      python3 - /etc/avahi/avahi-daemon.conf "${WAN_IF:-}" <<'PY' 2>/dev/null || true
import re, sys
path, wan = sys.argv[1], (sys.argv[2] if len(sys.argv) > 2 else "")
with open(path) as f: text = f.read()
def set_key(text, section, key, value):
    m = re.search(r'(?m)^\[%s\]\s*$' % re.escape(section), text)
    assert m, "missing [%s]" % section
    start = m.end()
    nxt = re.search(r'(?m)^\[', text[start:])
    end = start + nxt.start() if nxt else len(text)
    block = text[start:end]
    new_line = "%s=%s" % (key, value)
    if re.search(r'(?m)^#?%s=' % re.escape(key), block):
        block = re.sub(r'(?m)^#?%s=.*' % re.escape(key), new_line, block, count=1)
    else:
        block = block.rstrip("\n") + "\n" + new_line + "\n"
    return text[:start] + block + text[end:]
# Remove any stray enable-reflector= outside [reflector] (e.g. [rlimits])
# left by earlier naive sed edits — avahi refuses to start with those.
parts = re.split(r'(?m)^(\[.*\])\s*$', text)
for i in range(2, len(parts), 2):
    if parts[i-1].strip().lower() != '[reflector]':
        parts[i] = re.sub(r'(?m)^enable-reflector=.*\n?', '', parts[i])
text = ''.join(parts)
text = set_key(text, "reflector", "enable-reflector", "yes")
if wan:
    text = set_key(text, "server", "deny-interfaces", wan)
with open(path, "w") as f: f.write(text)
PY
      systemctl enable --now avahi-daemon >/dev/null 2>&1 || true
      systemctl restart avahi-daemon >/dev/null 2>&1 || true
    fi

    step 6c "Provisioning Suricata (guarded af-packet/HOME_NET tune)..."
    # Stock suricata.yaml ships placeholder NIC names that fail to bind on a
    # fresh install, so suricata.service can exit immediately. The guarded
    # tuner rewrites af-packet to the detected WAN/LAN interfaces and HOME_NET
    # to the LAN subnet ONLY when no configured interface exists; hand-tuned
    # installs are never touched. Best-effort: never fail the install.
    if [[ -f /etc/suricata/suricata.yaml && -f /usr/local/share/tuxwall/scripts/tune-suricata.py ]]; then
      if python3 /usr/local/share/tuxwall/scripts/tune-suricata.py /etc/suricata/suricata.yaml >/dev/null 2>&1; then
        echo "   Suricata af-packet rebound to detected WAN/LAN interfaces."
        systemctl enable suricata >/dev/null 2>&1 || true
        systemctl restart suricata >/dev/null 2>&1 || true
      else
        echo "   Suricata config already valid (af-packet interfaces exist) - untouched."
      fi
    fi

    step 6d "Enabling daily Suricata rule updates (suricata-update)..."
    # Ubuntu's suricata-update package ships no systemd timer, so rule sets
    # are fetched never or once and go stale. Enable our daily timer and pull
    # a first ruleset now (best-effort; Suricata live-reloads via its socket).
    # The first pull runs via systemd --no-block: it returns immediately and
    # fetches in the background under suricata-update.service (journald logs,
    # Nice=10, idle IO). Running suricata-update inline here stalls the whole
    # apt upgrade on an internet fetch while holding the dpkg lock - observed
    # on 2026-10-08's v2.9.4 install as a multi-second hang at this step.
    if [[ -f /etc/systemd/system/suricata-update.timer ]]; then
      systemctl daemon-reload >/dev/null 2>&1 || true
      systemctl enable --now suricata-update.timer >/dev/null 2>&1 || true
      systemctl start --no-block suricata-update.service >/dev/null 2>&1 || true
    fi

    step 7 "Enabling dashboard service and daily blocklist updates..."
    systemctl daemon-reload
    systemctl enable tuxwall.service >/dev/null 2>&1 || true
    systemctl enable tuxwall-blocklist-update.timer >/dev/null 2>&1 || true
    systemctl restart tuxwall.service || true

    step 8 "Triggering initial blocklist download (background)..."
    sleep 2
    curl -s -X POST http://127.0.0.1:8008/api/blocklists/update >/dev/null 2>&1 || true

    step 9 "Setting up the opencode AI agent (dashboard AI assistant)..."
    # Best-effort: needs internet for the opencode installer. The dashboard
    # works fine without it; re-run the script later if it fails.
    AGENT_SETUP=""
    for cand in /var/www/html/scripts/setup-opencode-agent.sh \
                /usr/local/share/tuxwall/scripts/setup-opencode-agent.sh; do
      [[ -f "$cand" ]] && AGENT_SETUP="$cand" && break
    done
    if [[ -z "$AGENT_SETUP" ]]; then
      echo "     SKIP: setup-opencode-agent.sh not shipped - agent step deferred."
      echo "     (tuxwall-agent.service already active; no action needed.)"
    elif bash "$AGENT_SETUP" \
            /etc/tuxwall/opencode.json \
            /etc/systemd/system/tuxwall-agent.service; then
      echo "     opencode agent ready (tuxwall-agent.service, 127.0.0.1:4096)"
    else
      echo "     WARNING: opencode agent setup failed (offline?). Re-run later:"
      echo "       sudo bash $AGENT_SETUP"
    fi

    echo
    echo "tuxwall installed. Dashboard: http://<this-host>/"
    echo "Watch blocklist progress on the Blocklists page, then verify:"
    echo "    dig adnxs.com @<this-host>   (should return NXDOMAIN)"
    echo
    echo "Guided SQM speedtest (official Ookla tarball, no snap/apt repo)..."
    # Ookla's packagecloud repo ends at jammy (404 on noble+); the snap is
    # an unofficial wrapper. Best-effort tarball install; the dashboard
    # degrades to manual caps with an install hint when absent.
    SPEEDTEST_SETUP=""
    for cand in /var/www/html/scripts/install-speedtest.sh \
                /usr/local/share/tuxwall/scripts/install-speedtest.sh; do
      [[ -f "$cand" ]] && SPEEDTEST_SETUP="$cand" && break
    done
    if command -v speedtest >/dev/null 2>&1; then
      echo "  speedtest already present ($(speedtest --version 2>/dev/null | head -n1))"
    elif [[ -n "$SPEEDTEST_SETUP" ]] && bash "$SPEEDTEST_SETUP" >/dev/null 2>&1; then
      echo "  speedtest installed ($(speedtest --version 2>/dev/null | head -n1))"
    else
      echo "  SKIP: speedtest not installed — System > Traffic Shaping shows a hint."
      echo "        Re-run later: sudo bash /var/www/html/scripts/install-speedtest.sh"
    fi
    echo
    echo "Optional extras:"
    echo "  - Security (attack map):   sudo bash /var/www/html/scripts/geoip-setup.sh"
    echo "  - AI threat summaries:     edit /etc/tuxwall/llm.json"
    echo "  - Kea DHCP leases page:    auto-configured on fresh installs (pool .100-.199);"
    echo "                              manage it from the dashboard DHCP page"
    echo
    ;;
esac

exit 0
