#!/usr/bin/env bash
# tuxwall postinst: full provisioning of the dashboard on the target system.
set -euo pipefail

WWW=/var/www/html
STATE_DIR=/var/lib/tuxwall

case "$1" in
  configure)

    echo "[1/9] Creating state directory ($STATE_DIR)..."
    mkdir -p "$STATE_DIR"
    chmod 755 "$STATE_DIR"

    echo "[2/9] Ensuring /etc/tuxwall exists..."
    mkdir -p /etc/tuxwall

    echo "[3/9] Creating empty blocklist configs (so Unbound includes are valid)..."
    # Must live under /var/lib/unbound/ - Unbound's AppArmor profile only allows
    # it to read /etc/unbound/** and /var/lib/unbound/**
    : > /var/lib/unbound/blocklist.conf
    cat > /var/lib/unbound/client-bans.conf <<'EOF'
# Managed by the tuxwall DHCP Clients page - DO NOT EDIT
server:
EOF

    echo "[4/9] Wiring blocklists into Unbound..."
    cat > /etc/unbound/unbound.conf.d/99-blocklists.conf <<'EOF'
# Managed by the tuxwall Blocklists page - DO NOT EDIT
server:
    # lets unbound-control report rcode stats so the dashboard can show
    # blocked-query counts (NXDOMAIN answers)
    extended-statistics: yes
include: "/var/lib/unbound/blocklist.conf"
include: "/var/lib/unbound/client-bans.conf"
EOF

    # Forwarder for fresh installs only. Never touch an existing
    # router-dns.conf - it may hold a full hand-tuned server config.
    if ! grep -qs '^forward-zone:' /etc/unbound/unbound.conf.d/*.conf /etc/unbound/unbound.conf 2>/dev/null; then
      if [[ ! -s /etc/unbound/unbound.conf.d/router-dns.conf ]]; then
        echo "   No forward-zone configured - adding upstream forwarder (1.1.1.1/8.8.8.8)..."
        cat > /etc/unbound/unbound.conf.d/router-dns.conf <<'EOF'
server:
    do-not-query-localhost: no
forward-zone:
    name: "."
    forward-addr: 1.1.1.1
    forward-addr: 8.8.8.8
EOF
      else
        echo "   router-dns.conf already exists without forward-zone (recursive mode) - leaving untouched."
      fi
    fi
    unbound-checkconf || true
    systemctl restart unbound || true

    echo "[5/9] Configuring nginx reverse proxy..."
    # Only manage the bundled vhost on fresh installs. If an enabled site
    # already serves the web root (custom router setup with SSL/vhosts),
    # leave nginx alone.
    if ! grep -rqs 'root /var/www/html' /etc/nginx/sites-enabled/; then
      if [[ ! -e /etc/nginx/sites-enabled/tuxwall ]]; then
        ln -sf /etc/nginx/sites-available/tuxwall /etc/nginx/sites-enabled/tuxwall
        rm -f /etc/nginx/sites-enabled/default
      fi
    else
      echo "   Existing site already serves /var/www/html - leaving nginx config untouched."
    fi
    if nginx -t >/dev/null 2>&1; then
      systemctl enable --now nginx >/dev/null 2>&1 || true
      systemctl reload nginx || true
    else
      echo "   WARNING: nginx config test failed - fix /etc/nginx/sites-available/tuxwall and reload nginx."
      nginx -t || true
    fi

    echo "[6/9] Setting up firewall (ufw)..."
    ufw allow OpenSSH >/dev/null 2>&1 || true
    ufw allow 80/tcp >/dev/null 2>&1 || true
    if ! ufw status 2>/dev/null | grep -q 'Status: active'; then
      ufw --force enable >/dev/null 2>&1 || true
    fi

    echo "[7/9] Enabling dashboard service and daily blocklist updates..."
    systemctl daemon-reload
    systemctl enable tuxwall.service >/dev/null 2>&1 || true
    systemctl enable tuxwall-blocklist-update.timer >/dev/null 2>&1 || true
    systemctl restart tuxwall.service || true

    echo "[8/9] Triggering initial blocklist download (background)..."
    sleep 2
    curl -s -X POST http://127.0.0.1:8008/api/blocklists/update >/dev/null 2>&1 || true

    echo "[9/9] Setting up the opencode AI agent (dashboard AI assistant)..."
    # Best-effort: needs internet for the opencode installer. The dashboard
    # works fine without it; re-run the script later if it fails.
    if bash /var/www/html/scripts/setup-opencode-agent.sh \
            /etc/tuxwall/opencode.json \
            /etc/systemd/system/tuxwall-agent.service; then
      echo "     opencode agent ready (tuxwall-agent.service, 127.0.0.1:4096)"
    else
      echo "     WARNING: opencode agent setup failed (offline?). Re-run later:"
      echo "       sudo bash /var/www/html/scripts/setup-opencode-agent.sh"
    fi

    echo
    echo "tuxwall installed. Dashboard: http://<this-host>/"
    echo "Watch blocklist progress on the Blocklists page, then verify:"
    echo "    dig doubleclick.net @<this-host>   (should return NXDOMAIN)"
    echo
    echo "Optional extras:"
    echo "  - Security (attack map):   sudo bash /var/www/html/scripts/geoip-setup.sh"
    echo "  - AI threat summaries:     edit /etc/tuxwall/llm.json"
    echo "  - Kea DHCP leases page:    configure /etc/kea/kea-dhcp4.conf and run"
    echo "                              sudo systemctl enable --now kea-dhcp4-server"
    echo
    ;;
esac

exit 0
