#!/usr/bin/env bash
# tuxwall prerm: stop/disable services before the package is removed.
set -euo pipefail

case "$1" in
  remove|upgrade|deconfigure)
    systemctl stop tuxwall.service 2>/dev/null || true
    systemctl disable tuxwall.service 2>/dev/null || true
    systemctl disable tuxwall-blocklist-update.timer 2>/dev/null || true
    # tripwire: keep running across upgrades (a trip in force stays
    # enforced); stopped only when the package is removed
    if [ "$1" = remove ]; then
      # the package disables it here, not the owner: forget the postinst
      # "enabled once" marker so a reinstall enables it again (kept when the
      # owner had disabled the unit - that choice survives a reinstall)
      if systemctl is-enabled --quiet tuxwall-tripwire.service 2>/dev/null; then
        rm -f /var/lib/tuxwall/.tripwire-enabled-once
      fi
      systemctl stop tuxwall-tripwire.service 2>/dev/null || true
      systemctl disable tuxwall-tripwire.service 2>/dev/null || true
      # device monitoring: same "enabled once" marker rule as the tripwire
      if systemctl is-enabled --quiet tuxwall-devicewatch.service 2>/dev/null; then
        rm -f /var/lib/tuxwall/.devicewatch-enabled-once
      fi
      systemctl stop tuxwall-devicewatch-feeds.timer tuxwall-devicewatch.service 2>/dev/null || true
      systemctl disable tuxwall-devicewatch-feeds.timer tuxwall-devicewatch.service 2>/dev/null || true
    fi
    ;;
esac

exit 0
