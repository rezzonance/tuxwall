    },
    {
      "action": "shell",
      "resource": "sudo systemctl is-active *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sudo journalctl *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sudo nft list *",
      "effect": "allow"
    },
    {
