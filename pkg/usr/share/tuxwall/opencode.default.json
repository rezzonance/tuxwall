      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*/etc/tuxwall/agent/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "/home/tuxwall-agent/.local/share/opencode/opencode.db*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*opencode.db*",
      "effect": "deny"
