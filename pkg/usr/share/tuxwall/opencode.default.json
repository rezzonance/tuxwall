  "instructions": [
    "/var/lib/tuxwall/agent/facts.md"
  ],
  "skills": [
    "/usr/share/tuxwall/agent-skills"
  ],
  "mcp": {
    "servers": {
      "tuxwall": {
        "type": "local",
        "command": [
          "/usr/bin/python3",
          "/usr/local/lib/tuxwall/tuxwall_mcp.py"
        ],
        "codemode": false
      }
    }
