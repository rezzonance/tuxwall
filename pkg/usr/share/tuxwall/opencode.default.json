    {
      "action": "tuxwall_firewall_findings",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "tuxwall_interfaces",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "tuxwall_dhcp_leases",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "tuxwall_dns_stats",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "tuxwall_crowdsec_decisions",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "tuxwall_security_events",
      "resource": "*",
      "effect": "allow"
