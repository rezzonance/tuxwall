#!/usr/bin/env bash
###############################################################################
#  tuxwall-setup - TuxWall first-boot setup wizard
#  ---------------------------------------------------------------------------
#  Asks which network port is the WAN (internet) and which is the LAN, the LAN
#  network and (optionally) the dashboard administrator, then runs
#  tuxwall-install.sh non-interactively with those answers. Shared by the
#  netinstall ISO and the VM images; shipped in the .deb so any install can
#  re-run it:  sudo tuxwall-setup
#
#  It never starts by itself on an existing install: the first-boot units
#  (tuxwall-setup@tty1.service, tuxwall-setup@ttyS0.service) only run while
#  /etc/tuxwall/setup-pending exists, which only the netinstaller / VM image
#  creates (image/common/install-firstboot.sh). Unattended first boot: put an
#  answers file at /etc/tuxwall/setup-answers (e.g. cloud-init write_files,
#  VM images) - the first-boot unit then runs it without asking, also when the
#  file appears while the console waits for Enter.
#
#    sudo tuxwall-setup                     guided setup (text UI)
#    sudo tuxwall-setup --plain             plain prompts (serial consoles)
#    sudo tuxwall-setup --answers FILE      no questions (automation / tests)
#    tuxwall-setup --answers FILE --print-command
#                                           show the installer command, change nothing
#    tuxwall-setup --list-nics              the network port table
#
#  Log: /var/log/tuxwall-setup.log   Installer log: /var/log/tuxwall-install.log
###############################################################################
set -uo pipefail
umask 022

PENDING=/etc/tuxwall/setup-pending
DONE_FILE=/etc/tuxwall/setup-done
LOCK=/run/tuxwall-setup.lock
LOG=/var/log/tuxwall-setup.log
INSTALL_LOG=/var/log/tuxwall-install.log
HINT=/etc/profile.d/zz-tuxwall-setup-hint.sh
AUTO_ANSWERS=/etc/tuxwall/setup-answers
# Shown above the console login prompt (agetty reads /etc/issue.d/*.issue):
# the dashboard URL + CA fingerprint stay visible after the wizard's screen
# is gone.
ISSUE=/etc/issue.d/zz-tuxwall.issue
WAN_NETPLAN=/etc/netplan/60-tuxwall-wan.yaml
API=http://127.0.0.1:8008
APT_PROBE=https://rezzonance.github.io/tuxwall/dists/stable/Release
# Test hook: a fixture directory laid out like /sys/class/net (no ip calls,
# no system changes are possible with it - see tools/netinstall_check.py).
SYS_NET=${TUXWALL_SETUP_SYSNET:-/sys/class/net}
FIXTURE=0; [[ $SYS_NET != /sys/class/net ]] && FIXTURE=1
LAN_CANDIDATES=(192.168.1.1/24 192.168.50.1/24 10.20.30.1/24 172.20.0.1/24)
INSTALLER_PATHS=(/usr/local/share/tuxwall/tuxwall-install.sh /opt/tuxwall-appliance/src/tuxwall-install.sh)

# ── Answers (asked, or read from --answers) ─────────────────────────────────
ROLE=gateway WAN="" WAN_MODE="" WAN_ADDRESS="" WAN_GATEWAY="" WAN_DNS=""
LAN="" LAN_SUBNET="" ADMIN_USER="" ADMIN_PASSWORD="" ADMIN_PASSWORD_FILE="" SOURCE=apt DEB_FILE=""
EXTRA_ARGS=()
# ── Options ─────────────────────────────────────────────────────────────────
CONSOLE_TTY="" ANSWERS="" AUTO_RUN=0 PRINT_ONLY=0 LIST_ONLY=0 UI="" INSTALLER="${TUXWALL_INSTALLER:-}"
PHYS=()

log() { { [[ -w $LOG ]] || [[ ! -e $LOG && -w ${LOG%/*} ]]; } && printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG" 2>/dev/null; return 0; }
say() { printf '%s\n' "$*"; log "$*"; }
die() { printf 'tuxwall-setup: %s\n' "$*" >&2; log "FATAL $*"; exit 1; }

usage() { sed -n '2,25p' "$0" | sed 's/^#  \{0,1\}//'; }

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --console)       CONSOLE_TTY="${2:-}"; shift 2 ;;
            --answers)       ANSWERS="${2:-}"; shift 2 ;;
            --print-command) PRINT_ONLY=1; shift ;;
            --list-nics)     LIST_ONLY=1; shift ;;
            --plain)         UI=plain; shift ;;
            --tui)           UI=tui; shift ;;
            --installer)     INSTALLER="${2:-}"; shift 2 ;;
            -h|--help)       usage; exit 0 ;;
            *)               usage >&2; die "unknown option: $1" ;;
        esac
    done
    if [[ -n $CONSOLE_TTY && ! $CONSOLE_TTY =~ ^(tty[0-9]+|ttyS[0-9]+|ttyAMA[0-9]+|hvc[0-9]+|ttyUSB[0-9]+)$ ]]; then
        die "--console: not a console device name: $CONSOLE_TTY"
    fi
    (( PRINT_ONLY )) && [[ -z $ANSWERS ]] && die "--print-command needs --answers FILE"
    return 0
}

###############################################################################
#  Network ports
###############################################################################
valid_ifname() { [[ $1 =~ ^[A-Za-z0-9_.:-]{1,15}$ ]]; }

detect_phys() {   # same rules as tuxwall-install.sh detect_phys_ifaces
    PHYS=()
    local p n
    for p in "$SYS_NET"/*; do
        [[ -e $p ]] || continue
        n=${p##*/}
        [[ $n == lo ]] && continue
        valid_ifname "$n" || continue
        [[ -e $p/device ]] || continue
        [[ -d $p/bridge || -d $p/bonding ]] && continue
        PHYS+=("$n")
    done
}

nic_mac()    { cat "$SYS_NET/$1/address" 2>/dev/null || echo "?"; }
nic_driver() { local d; d="$(readlink "$SYS_NET/$1/device/driver" 2>/dev/null)"; echo "${d##*/}"; }
nic_wireless() { [[ -d $SYS_NET/$1/wireless || -e $SYS_NET/$1/phy80211 ]]; }
nic_carrier() {   # 1 = link, 0 = no link, "" = interface down (unknown)
    local c; c="$(cat "$SYS_NET/$1/carrier" 2>/dev/null)" || c=""
    echo "$c"
}
nic_link() { case "$(nic_carrier "$1")" in 1) echo "link up" ;; 0) echo "no link" ;; *) echo "down" ;; esac; }
nic_speed() {
    local s; s="$(cat "$SYS_NET/$1/speed" 2>/dev/null)" || s=""
    if [[ ! $s =~ ^[0-9]+$ ]] || (( s <= 0 )); then echo "-"; return; fi
    if (( s >= 1000 && s % 1000 == 0 )); then echo "$((s / 1000))G"
    elif (( s >= 1000 )); then awk -v s="$s" 'BEGIN{printf "%.1fG\n", s/1000}'
    else echo "${s}M"; fi
}
nic_v4() {
    if (( FIXTURE )); then cat "$SYS_NET/$1/tw_ipv4" 2>/dev/null || true; return; fi
    { ip -4 -o addr show dev "$1" scope global 2>/dev/null || true; } | awk '{print $4}' | paste -sd' ' -
}
default_route_if() {
    if (( FIXTURE )); then cat "$SYS_NET/tw_default_route" 2>/dev/null || true; return; fi
    ip -4 route show default 2>/dev/null | awk '{for (i=1;i<NF;i++) if ($i=="dev") {print $(i+1); exit}}'
}
nic_row() {   # one table line
    local n=$1 tags=""
    [[ $n == "$(default_route_if)" ]] && tags+=" [internet]"
    nic_wireless "$n" && tags+=" [wireless]"
    printf '%-12s %-17s %-10s %-5s %-8s %s%s' "$n" "$(nic_mac "$n")" "$(nic_driver "$n" | cut -c1-10)" \
        "$(nic_speed "$n")" "$(nic_link "$n")" "$(nic_v4 "$n")" "$tags"
}
nic_table() {
    printf '%-12s %-17s %-10s %-5s %-8s %s\n' PORT MAC DRIVER SPEED LINK IPv4
    local n
    for n in "${PHYS[@]}"; do nic_row "$n"; printf '\n'; done
}

links_up() {   # carrier is only visible on interfaces that are administratively up
    (( FIXTURE )) && return 0
    local n
    for n in "${PHYS[@]}"; do
        nic_wireless "$n" && continue
        if ! ip -o link show dev "$n" 2>/dev/null | grep -q '[<,]UP[,>]'; then
            ip link set dev "$n" up >/dev/null 2>&1 && log "set $n up (link detection)"
        fi
    done
    sleep 2
}

# Watch for a cable being plugged in: prints the port whose link came up.
detect_plug() {   # detect_plug SECONDS -> echo port (empty on timeout/cancel)
    local secs=${1:-60} n t=0 key="" found=""
    local -A before=()
    for n in "${PHYS[@]}"; do before[$n]="$(nic_carrier "$n")"; done
    while (( t < secs * 2 )); do
        for n in "${PHYS[@]}"; do
            local now; now="$(nic_carrier "$n")"
            if [[ $now == 1 && ${before[$n]} != 1 ]]; then found=$n; break 2; fi
            before[$n]=$now
        done
        printf '\r  Waiting for a cable to be plugged in ... %2ds left (Enter = cancel) ' "$(( secs - t / 2 ))" >&2
        if read -r -t 0.5 key 2>/dev/null; then break; fi
        t=$((t + 1))
    done
    printf '\r\033[K' >&2
    : "$key"
    echo "$found"
}

###############################################################################
#  User interface: whiptail (tty) or plain prompts (serial, --plain)
###############################################################################
ui_dims() {
    local rows=24 cols=80 s
    s="$(stty size 2>/dev/null)" && read -r rows cols <<<"$s"
    (( rows < 15 )) && rows=24
    (( cols < 60 )) && cols=80
    UH=$(( rows - 2 > 22 ? 22 : rows - 2 ))
    UW=$(( cols - 4 > 78 ? 78 : cols - 4 ))
}
ui_msg() {   # ui_msg TITLE TEXT
    if [[ $UI == tui ]]; then
        ui_dims; whiptail --title "$1" --msgbox "$2" "$UH" "$UW"
    else
        printf '\n== %s ==\n%s\n' "$1" "$2"
        read -r -p "Press Enter to continue. " _ || true
    fi
}
ui_yesno() {   # ui_yesno TITLE TEXT [yes-label no-label] -> 0 yes / 1 no
    local yl=${3:-Yes} nl=${4:-No} a
    if [[ $UI == tui ]]; then
        ui_dims; whiptail --title "$1" --yes-button "$yl" --no-button "$nl" --yesno "$2" "$UH" "$UW"
        return
    fi
    printf '\n== %s ==\n%s\n' "$1" "$2"
    while true; do
        read -r -p "[y] $yl / [n] $nl: " a || return 1
        case "${a,,}" in y|yes) return 0 ;; n|no) return 1 ;; esac
    done
}
ui_menu() {   # ui_menu VAR TITLE TEXT DEFAULT_TAG tag desc [tag desc ...] -> rc 1 = back/cancel
    local __v=$1 title=$2 text=$3 def=$4; shift 4
    local -a items=("$@") tags=()
    local i ans
    for ((i = 0; i < ${#items[@]}; i += 2)); do tags+=("${items[i]}"); done
    if [[ $UI == tui ]]; then
        ui_dims
        ans="$(whiptail --title "$title" --default-item "$def" --menu "$text" "$UH" "$UW" \
               "$(( ${#tags[@]} > UH - 9 ? UH - 9 : ${#tags[@]} ))" "${items[@]}" 3>&1 1>&2 2>&3)" || return 1
        printf -v "$__v" '%s' "$ans"
        return 0
    fi
    printf '\n== %s ==\n%s\n' "$title" "$text"
    local defn=1
    for ((i = 0; i < ${#tags[@]}; i++)); do
        [[ ${tags[i]} == "$def" ]] && defn=$((i + 1))
        printf '  %2d) %-12s %s\n' "$((i + 1))" "${tags[i]}" "${items[i * 2 + 1]}"
    done
    while true; do
        read -r -p "Choose 1-${#tags[@]} (Enter = $defn, b = back): " ans || return 1
        ans=${ans:-$defn}
        [[ $ans =~ ^[bB]$ ]] && return 1
        if [[ $ans =~ ^[0-9]+$ ]] && (( ans >= 1 && ans <= ${#tags[@]} )); then
            printf -v "$__v" '%s' "${tags[ans - 1]}"
            return 0
        fi
    done
}
ui_input() {   # ui_input VAR TITLE TEXT DEFAULT -> rc 1 = back
    local __v=$1 ans
    if [[ $UI == tui ]]; then
        ui_dims
        ans="$(whiptail --title "$2" --inputbox "$3" "$UH" "$UW" "$4" 3>&1 1>&2 2>&3)" || return 1
    else
        printf '\n== %s ==\n%s\n' "$2" "$3"
        read -r -p "[${4}] (b = back): " ans || return 1
        [[ $ans =~ ^[bB]$ ]] && return 1
        ans=${ans:-$4}
    fi
    printf -v "$__v" '%s' "$ans"
}
ui_password() {   # ui_password VAR TITLE TEXT -> rc 1 = cancel
    local __v=$1 ans
    if [[ $UI == tui ]]; then
        ui_dims
        ans="$(whiptail --title "$2" --passwordbox "$3" "$UH" "$UW" 3>&1 1>&2 2>&3)" || return 1
    else
        printf '\n%s\n' "$3"
        read -r -s -p "Password: " ans || return 1
        printf '\n'
    fi
    printf -v "$__v" '%s' "$ans"
}

###############################################################################
#  Validation (subnet maths reused from tuxwall-install.sh: net_calc)
###############################################################################
find_installer() {
    local p
    if [[ -n $INSTALLER ]]; then
        [[ -f $INSTALLER ]] || die "installer not found: $INSTALLER"
        return 0
    fi
    for p in "${INSTALLER_PATHS[@]}"; do
        [[ -f $p ]] && { INSTALLER=$p; return 0; }
    done
    return 1
}

net_calc() {   # net_calc CIDR [avoid ...] -> OK|net|gw|mask|prefix|lo|hi  or  ERR|reason
    # tuxwall-install.sh only runs main() when executed, so sourcing it in a
    # subshell gives us its functions without forking the logic.
    ( # shellcheck source=/dev/null
      source "$INSTALLER" >/dev/null 2>&1 || exit 1
      trap - ERR; set +e
      net_calc "$@" ) || echo "ERR|could not check the network (installer missing?)"
}

valid_ipv4() { [[ $1 =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] && (( BASH_REMATCH[1] <= 255 && BASH_REMATCH[2] <= 255 && BASH_REMATCH[3] <= 255 && BASH_REMATCH[4] <= 255 )); }
valid_cidr4() { [[ $1 == */* ]] && valid_ipv4 "${1%/*}" && [[ ${1#*/} =~ ^[0-9]{1,2}$ ]] && (( ${1#*/} >= 8 && ${1#*/} <= 32 )); }
valid_dns_list() { local d; IFS=', ' read -r -a _dl <<<"$1"; (( ${#_dl[@]} )) || return 1; for d in "${_dl[@]}"; do valid_ipv4 "$d" || return 1; done; }

wan_networks() {   # networks to keep the LAN away from
    if [[ $WAN_MODE == static && -n $WAN_ADDRESS ]]; then echo "$WAN_ADDRESS"; fi
    [[ -n $WAN ]] && nic_v4 "$WAN" | tr ' ' '\n' | sed '/^$/d'
    local n
    for n in "${PHYS[@]}"; do
        [[ $n == "$LAN" || $n == "$WAN" ]] && continue
        nic_v4 "$n" | tr ' ' '\n' | sed '/^$/d'
    done
}

default_subnet() {
    local c r avoid=()
    mapfile -t avoid < <(wan_networks)
    for c in "${LAN_CANDIDATES[@]}"; do
        r="$(net_calc "$c" "${avoid[@]}")"
        [[ $r == OK* ]] && { echo "$c"; return; }
    done
    echo "${LAN_CANDIDATES[0]}"
}

check_answers() {   # -> 0, or prints the problem
    [[ $ROLE == gateway || $ROLE == dashboard ]] || { echo "ROLE must be gateway or dashboard"; return 1; }
    [[ $SOURCE == apt || $SOURCE == deb ]] || { echo "SOURCE must be apt or deb"; return 1; }
    if [[ $SOURCE == deb ]] && [[ ! -f $DEB_FILE ]]; then echo "DEB_FILE not found: $DEB_FILE"; return 1; fi
    [[ $ROLE == dashboard ]] && return 0
    local n ok
    for n in WAN LAN; do
        valid_ifname "${!n}" || { echo "$n: invalid interface name '${!n}'"; return 1; }
        ok=0; local p; for p in "${PHYS[@]}"; do [[ $p == "${!n}" ]] && ok=1; done
        (( ok )) || { echo "$n: no such network port: ${!n}"; return 1; }
    done
    [[ $WAN != "$LAN" ]] || { echo "WAN and LAN must be different ports"; return 1; }
    nic_wireless "$LAN" && { echo "the LAN must be a wired port ($LAN is wireless)"; return 1; }
    case "$WAN_MODE" in
        dhcp|keep) ;;
        static)
            valid_cidr4 "$WAN_ADDRESS" || { echo "WAN_ADDRESS must look like 203.0.113.10/24"; return 1; }
            valid_ipv4 "$WAN_GATEWAY" || { echo "WAN_GATEWAY must be an IPv4 address"; return 1; }
            valid_dns_list "$WAN_DNS" || { echo "WAN_DNS must be one or more IPv4 addresses"; return 1; } ;;
        *) echo "WAN_MODE must be dhcp, static or keep"; return 1 ;;
    esac
    local r avoid=()
    mapfile -t avoid < <(wan_networks)
    r="$(net_calc "$LAN_SUBNET" "${avoid[@]}")"
    [[ $r == OK* ]] || { echo "LAN_SUBNET $LAN_SUBNET: ${r#ERR|}"; return 1; }
    if [[ -n $ADMIN_USER ]]; then
        [[ $ADMIN_USER =~ ^[A-Za-z0-9_.-]{1,32}$ ]] || { echo "ADMIN_USER: 1-32 letters, digits, _ . -"; return 1; }
        (( ${#ADMIN_PASSWORD} >= 8 )) || { echo "admin password: at least 8 characters"; return 1; }
    fi
    return 0
}

# The tuxwall-install.sh command line (array INSTALL_CMD).
build_install_cmd() {
    INSTALL_CMD=(bash "$INSTALLER" --source "$SOURCE")
    [[ $SOURCE == deb ]] && INSTALL_CMD+=(--deb "$DEB_FILE")
    INSTALL_CMD+=(--role "$ROLE")
    if [[ $ROLE == gateway ]]; then
        local mode=dhcp
        [[ $WAN_MODE == dhcp ]] || mode=keep    # static: this wizard writes the WAN netplan itself
        INSTALL_CMD+=(--wan "$WAN" --lan "$LAN" --wan-mode "$mode" --subnet "$LAN_SUBNET")
    fi
    INSTALL_CMD+=("${EXTRA_ARGS[@]}" -y)
}

###############################################################################
#  Answers file (KEY=VALUE, never sourced)
###############################################################################
read_answers() {
    local f=$1 line k v
    [[ -r $f ]] || die "answers file not readable: $f"
    while IFS= read -r line || [[ -n $line ]]; do
        line="${line%$'\r'}"
        [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
        [[ $line =~ ^([A-Z_]+)=(.*)$ ]] || die "answers: bad line: $line"
        k=${BASH_REMATCH[1]} v=${BASH_REMATCH[2]}
        v="${v#\"}"; v="${v%\"}"
        case "$k" in
            ROLE|WAN|WAN_MODE|WAN_ADDRESS|WAN_GATEWAY|WAN_DNS|LAN|LAN_SUBNET|ADMIN_USER|SOURCE|DEB_FILE)
                printf -v "$k" '%s' "$v" ;;
            WAN_MAC|LAN_MAC)   # a port by MAC address (names differ between machines)
                local p hit=""
                for p in "${PHYS[@]}"; do [[ "$(nic_mac "$p")" == "${v,,}" ]] && hit=$p; done
                [[ -n $hit ]] || die "answers: no network port with MAC $v"
                printf -v "${k%_MAC}" '%s' "$hit" ;;
            ADMIN_PASSWORD_FILE)
                [[ -r $v ]] || die "answers: ADMIN_PASSWORD_FILE not readable"
                ADMIN_PASSWORD_FILE=$v
                ADMIN_PASSWORD="$(head -n1 "$v")" ;;
            EXTRA)
                local a
                for a in $v; do
                    case "$a" in
                        --no-crowdsec|--no-agent|--no-speedtest|--no-geoip|--ssh-wan) EXTRA_ARGS+=("$a") ;;
                        *) die "answers: EXTRA allows --no-crowdsec --no-agent --no-speedtest --no-geoip --ssh-wan (got $a)" ;;
                    esac
                done ;;
            *) die "answers: unknown key $k" ;;
        esac
    done <"$f"
    [[ -n $WAN_MODE ]] || WAN_MODE=dhcp
    if [[ $ROLE == gateway && -z $LAN_SUBNET ]]; then LAN_SUBNET="$(default_subnet)"; fi
    return 0
}

###############################################################################
#  WAN preparation: the installer needs the internet before it starts
###############################################################################
wan_netplan_yaml() {
    echo "# Written by tuxwall-setup on $(date '+%F %T'): WAN = $WAN ($WAN_MODE)."
    echo "network:"
    echo "  version: 2"
    echo "  ethernets:"
    echo "    $WAN:"
    if [[ $WAN_MODE == static ]]; then
        local d dl=()
        IFS=', ' read -r -a dl <<<"$WAN_DNS"
        echo "      dhcp4: false"
        echo "      dhcp6: false"
        echo "      addresses: [\"$WAN_ADDRESS\"]"
        echo "      routes:"
        echo "        - to: default"
        echo "          via: $WAN_GATEWAY"
        echo "      nameservers:"
        printf '        addresses: ['; local first=1
        for d in "${dl[@]}"; do (( first )) || printf ', '; printf '%s' "$d"; first=0; done; printf ']\n'
    else
        echo "      dhcp4: true"
        echo "      optional: true"
    fi
}

have_internet() {
    getent ahosts rezzonance.github.io >/dev/null 2>&1 || return 1
    curl -fsS -m 20 -o /dev/null "$APT_PROBE" >/dev/null 2>&1
}

# Cloud images (VM image, Proxmox cloud-init): cloud-init's netplan may rename
# a port at the next boot (Proxmox: set-name eth0, which fails while the port
# is up at first boot) - TuxWall's config would then name a port that no
# longer exists. Keep every port's current name, and stop cloud-init from
# rewriting the network config later (Proxmox changes the instance id when
# its cloud-init settings are edited).
CLOUD_NETPLAN=/etc/netplan/50-cloud-init.yaml
CLOUD_NET_OFF=/etc/cloud/cloud.cfg.d/99-tuxwall-network.cfg
CLOUD_NETPLAN_ORIG=/etc/tuxwall/50-cloud-init.yaml.orig
pin_cloud_init_network() {
    (( FIXTURE )) && return 0
    [[ -d ${CLOUD_NET_OFF%/*} ]] || return 0
    if [[ -f $CLOUD_NETPLAN ]]; then
        local msg
        msg="$(python3 - "$CLOUD_NETPLAN" "$SYS_NET" "$CLOUD_NET_OFF" "$CLOUD_NETPLAN_ORIG" <<'PY'
import os, shutil, sys
import yaml
path, sysnet, off, bak = sys.argv[1:]
d = yaml.safe_load(open(path)) or {}
eth = (d.get("network") or {}).get("ethernets") or {}
names = {}
for n in os.listdir(sysnet):
    try:
        names[open(os.path.join(sysnet, n, "address")).read().strip().lower()] = n
    except OSError:
        pass
out, notes = {}, []
for key, cfg in eth.items():
    cfg = dict(cfg or {})
    mac = str((cfg.get("match") or {}).get("macaddress", "")).lower()
    cur = names.get(mac)
    if cur:
        if cfg.get("set-name") and cfg["set-name"] != cur:
            notes.append("%s: keep the name %s (no rename to %s)" % (mac, cur, cfg.pop("set-name")))
        if key != cur and cur not in eth:
            notes.append("%s: entry %s -> %s" % (mac, key, cur))
            key = cur
    out[key] = cfg
if notes:
    d["network"]["ethernets"] = out
    if not os.path.exists(bak):
        shutil.copy2(path, bak)
    tmp = path + ".tuxwall-tmp"
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        f.write("# cloud-init's network config, ports pinned to their current names by tuxwall-setup\n")
        f.write("# (original: %s). cloud-init no longer manages it (%s).\n" % (bak, off))
        yaml.safe_dump(d, f, default_flow_style=False, sort_keys=False)
    os.replace(tmp, path)
print("; ".join(notes))
PY
)" || { say "warning: could not check $CLOUD_NETPLAN (see $LOG)"; msg=""; }
        [[ -n $msg ]] && say "cloud-init network config: $msg"
    fi
    if [[ ! -e $CLOUD_NET_OFF ]]; then
        printf '# Written by tuxwall-setup: TuxWall manages the network configuration.\nnetwork: {config: disabled}\n' \
            >"$CLOUD_NET_OFF" && log "cloud-init network config disabled ($CLOUD_NET_OFF)"
    fi
    return 0
}

prepare_wan() {   # -> 0 when the internet works
    pin_cloud_init_network
    if [[ $ROLE == gateway ]]; then
        if [[ $WAN_MODE == static ]] || { [[ $WAN_MODE == dhcp ]] && [[ -z "$(nic_v4 "$WAN")" ]]; }; then
            say "Configuring $WAN ($WAN_MODE) ..."
            local tmp; tmp="$(mktemp)"
            wan_netplan_yaml >"$tmp"
            [[ -e $WAN_NETPLAN ]] && cp -a "$WAN_NETPLAN" "$WAN_NETPLAN.tuxwall-setup-prev" 2>/dev/null
            install -m 600 "$tmp" "$WAN_NETPLAN"; rm -f "$tmp"
            if ! netplan generate >>"$LOG" 2>&1; then
                rm -f "$WAN_NETPLAN"
                say "netplan rejected the WAN settings (details in $LOG)."
                return 1
            fi
            netplan apply >>"$LOG" 2>&1 || say "netplan apply reported an error (see $LOG)"
            local i
            for ((i = 0; i < 30; i++)); do [[ -n "$(nic_v4 "$WAN")" ]] && break; sleep 1; done
        fi
    fi
    local i
    for ((i = 0; i < 3; i++)); do have_internet && return 0; sleep 3; done
    return 1
}

###############################################################################
#  Interactive steps
###############################################################################
nic_menu_items() {   # nic_menu_items EXCLUDE -> fills MENU
    MENU=()
    local n
    for n in "${PHYS[@]}"; do
        [[ $n == "${1:-}" ]] && continue
        MENU+=("$n" "$(nic_row "$n" | cut -c14- | sed 's/  */ /g')")
    done
}

step_welcome() {
    local c
    while true; do
        ui_menu c "TuxWall setup" \
"This machine runs Ubuntu; TuxWall is not set up yet.

The setup picks the internet (WAN) and local (LAN) ports, then installs
TuxWall from its signed APT repository. Network ports found: ${#PHYS[@]}" start \
            start    "Start the setup" \
            ports    "Show the network ports" \
            later    "Not now (ask again at the next boot)" \
            never    "Don't ask again (run 'sudo tuxwall-setup' later)" || c=later
        case "$c" in
            start) return 0 ;;
            ports) ui_msg "Network ports" "$(nic_table)" ;;
            later) say "Setup postponed."; return 2 ;;
            never) disarm "postponed by the user"; say "Setup will not start at boot; run 'sudo tuxwall-setup' when ready."; return 2 ;;
        esac
    done
}

step_role() {
    ROLE=gateway
    (( ${#PHYS[@]} >= 2 )) && return 0
    local c
    ui_menu c "Only ${#PHYS[@]} network port" \
"A gateway needs two network ports: one to the internet (WAN), one to your
devices (LAN). With ${#PHYS[@]} port TuxWall can still run as a dashboard
(firewall, monitoring) without routing your network." dashboard \
        dashboard "Install TuxWall as a dashboard only" \
        quit      "Quit (add a network port, then run sudo tuxwall-setup)" || return 1
    [[ $c == dashboard ]] || return 2
    ROLE=dashboard
}

step_wan() {
    local c def="${WAN:-$(default_route_if)}" found
    [[ -n $def ]] || def=${PHYS[0]}
    while true; do
        nic_menu_items ""
        ui_menu c "Internet port (WAN)" \
"Which port is connected to your modem / ISP?
Not sure? Choose 'Detect' and plug the modem cable in when asked." "$def" \
            "${MENU[@]}" detect "Detect: plug the WAN cable in now" || return 1
        if [[ $c == detect ]]; then
            links_up
            [[ $UI == tui ]] && clear
            printf '\nUnplug the modem cable if it is plugged in, then plug it into the port\nyou want as WAN. Ports and their link state:\n\n' >&2
            nic_table >&2
            found="$(detect_plug 60)"
            if [[ -n $found ]]; then
                def=$found
                ui_msg "Port detected" "The cable was plugged into $found ($(nic_mac "$found")). It is preselected as WAN."
            else
                ui_msg "No cable detected" "No port changed to 'link up'. Choose the WAN port from the list."
            fi
            continue
        fi
        WAN=$c
        return 0
    done
}

step_wan_mode() {
    local c cur
    cur="$(nic_v4 "$WAN")"
    ui_menu c "WAN addressing ($WAN)" \
"How does this port get its internet address?${cur:+
Current address: $cur}
PPPoE is not supported by the installer yet: use your ISP router in
bridge/DHCP mode or let it do PPPoE." "${WAN_MODE:-dhcp}" \
        dhcp   "DHCP from the modem / ISP (most connections)" \
        static "Static address from your ISP" \
        keep   "Keep the current configuration of $WAN" || return 1
    WAN_MODE=$c
    [[ $WAN_MODE == static ]] || return 0
    local v
    while true; do
        ui_input v "Static WAN address" "Address and prefix from your ISP (e.g. 203.0.113.10/24):" "$WAN_ADDRESS" || return 1
        valid_cidr4 "$v" && { WAN_ADDRESS=$v; break; }
        ui_msg "Invalid" "Use address/prefix, for example 203.0.113.10/24."
    done
    while true; do
        ui_input v "Static WAN gateway" "Gateway (next hop) from your ISP:" "$WAN_GATEWAY" || return 1
        valid_ipv4 "$v" && { WAN_GATEWAY=$v; break; }
        ui_msg "Invalid" "Enter an IPv4 address."
    done
    while true; do
        ui_input v "DNS servers" "DNS servers for the router itself (comma separated):" "${WAN_DNS:-9.9.9.9,1.1.1.1}" || return 1
        valid_dns_list "$v" && { WAN_DNS=$v; break; }
        ui_msg "Invalid" "Enter one or more IPv4 addresses separated by commas."
    done
}

step_internet() {
    while true; do
        [[ $UI == tui ]] && clear
        say "Checking the internet connection on ${WAN:-this machine} ..."
        prepare_wan && return 0
        local c
        ui_menu c "No internet" \
"The internet is not reachable through ${WAN:-this machine} ($WAN_MODE).
TuxWall is installed from the internet, so the WAN must work first.
Check the cable/modem, or pick another port or mode." retry \
            retry  "Try again" \
            back   "Change the WAN port / mode" \
            ignore "Continue anyway (the install will fail without internet)" || return 1
        case "$c" in retry) ;; back) return 1 ;; ignore) return 0 ;; esac
    done
}

step_lan() {
    local c def="$LAN" n
    if [[ -z $def || $def == "$WAN" ]]; then
        def=""
        for n in "${PHYS[@]}"; do
            [[ $n == "$WAN" ]] && continue
            nic_wireless "$n" && continue
            [[ -z $def ]] && def=$n
            [[ "$(nic_carrier "$n")" == 1 ]] && { def=$n; break; }
        done
    fi
    while true; do
        nic_menu_items "$WAN"
        ui_menu c "Local port (LAN)" \
"Which port connects to your switch / devices? TuxWall serves DHCP and DNS
there. SSH to this machine stays reachable from the LAN." "$def" "${MENU[@]}" || return 1
        if nic_wireless "$c"; then ui_msg "Wireless" "The LAN must be a wired port; use an access point for Wi-Fi."; continue; fi
        LAN=$c
        return 0
    done
}

step_subnet() {
    local v r avoid=() def
    mapfile -t avoid < <(wan_networks)
    def="${LAN_SUBNET:-$(default_subnet)}"
    while true; do
        ui_input v "LAN network" \
"Gateway address and prefix of your LAN (this router's address on $LAN).
192.168.1.1/24 suits most homes; a different one is suggested when it
would collide with the WAN network." "$def" || return 1
        r="$(net_calc "$v" "${avoid[@]}")"
        if [[ $r == OK* ]]; then LAN_SUBNET=$v; return 0; fi
        ui_msg "Not usable" "${r#ERR|}"
        def="$(default_subnet)"
    done
}

step_admin() {
    local u p p2
    if ! ui_yesno "Dashboard administrator" \
"Create the dashboard's administrator account now? (recommended)

Otherwise the first person who opens the dashboard creates it." "Create now" "Later"; then
        ADMIN_USER="" ADMIN_PASSWORD=""
        return 0
    fi
    while true; do
        ui_input u "Administrator" "Dashboard user name (letters, digits, _ . -):" "${ADMIN_USER:-admin}" || return 1
        [[ $u =~ ^[A-Za-z0-9_.-]{1,32}$ ]] && break
        ui_msg "Invalid" "1-32 characters: letters, digits, _ . -"
    done
    while true; do
        ui_password p "Administrator password" "Password for $u (at least 8 characters):" || return 1
        if (( ${#p} < 8 )); then ui_msg "Too short" "Use at least 8 characters."; continue; fi
        ui_password p2 "Administrator password" "Repeat the password:" || return 1
        [[ $p == "$p2" ]] && break
        ui_msg "Mismatch" "The passwords differ; try again."
    done
    ADMIN_USER=$u ADMIN_PASSWORD=$p
}

summary_text() {
    local r gw="" pool=""
    if [[ $ROLE == gateway ]]; then
        local avoid=(); mapfile -t avoid < <(wan_networks)
        r="$(net_calc "$LAN_SUBNET" "${avoid[@]}")"
        IFS='|' read -r _ _ gw _ _ lo hi <<<"$r"; pool="$lo - $hi"
        printf 'Role:       full gateway (routing, NAT, DHCP, DNS, firewall)\n'
        case "$WAN_MODE" in
            dhcp)   printf 'WAN:        %s  DHCP v4 + v6 from the ISP\n' "$WAN" ;;
            static) printf 'WAN:        %s  static %s via %s, DNS %s\n' "$WAN" "$WAN_ADDRESS" "$WAN_GATEWAY" "$WAN_DNS" ;;
            keep)   printf 'WAN:        %s  keep current config (%s)\n' "$WAN" "$(nic_v4 "$WAN")" ;;
        esac
        printf 'LAN:        %s  %s  (DHCP pool %s)\n' "$LAN" "$LAN_SUBNET" "$pool"
        if [[ " ${EXTRA_ARGS[*]} " == *" --ssh-wan "* ]]; then printf 'SSH:        from the LAN and the WAN (--ssh-wan)\n'
        else printf 'SSH:        from the LAN only (never the WAN)\n'; fi
        printf 'Dashboard:  https://%s/\n' "$gw"
    else
        printf 'Role:       dashboard only (network config unchanged)\n'
    fi
    if [[ -n $ADMIN_USER ]]; then printf 'Admin:      create "%s" now\n' "$ADMIN_USER"
    else printf 'Admin:      the first visitor of the dashboard creates it\n'; fi
    printf 'Source:     %s\n' "$([[ $SOURCE == apt ]] && echo 'signed TuxWall APT repository' || echo "$DEB_FILE")"
    printf 'Log:        %s\n' "$INSTALL_LOG"
}

###############################################################################
#  Install, admin account, finish
###############################################################################
run_install() {
    build_install_cmd
    log "running: ${INSTALL_CMD[*]}"
    [[ $UI == tui ]] && clear
    printf '\nInstalling TuxWall - this takes a few minutes. Full log: %s\n' "$INSTALL_LOG"
    local rc=0
    TERM=${TERM:-linux} "${INSTALL_CMD[@]}" || rc=$?
    log "installer exit code $rc"
    return "$rc"
}

create_admin() {   # POST /api/auth/setup on the loopback API; password via stdin
    [[ -n $ADMIN_USER ]] || return 0
    local i
    for ((i = 0; i < 30; i++)); do curl -fsS -m 3 -o /dev/null "$API/api/auth/session" 2>/dev/null && break; sleep 1; done
    printf '%s' "$ADMIN_PASSWORD" | python3 -c '
import json, sys, urllib.request, urllib.error
user, api = sys.argv[1], sys.argv[2]
body = json.dumps({"username": user, "password": sys.stdin.read()}).encode()
req = urllib.request.Request(api + "/api/auth/setup", data=body, headers={"Content-Type": "application/json"})
try:
    with urllib.request.urlopen(req, timeout=20) as r:
        ok = json.load(r).get("ok")
except urllib.error.HTTPError as e:
    try:
        msg = json.load(e).get("error", str(e))
    except Exception:
        msg = str(e)
    print(msg); sys.exit(1)
except Exception as e:
    print(e); sys.exit(1)
sys.exit(0 if ok else 1)' "$ADMIN_USER" "$API"
}

setup_required() {
    curl -fsS -m 5 "$API/api/auth/session" 2>/dev/null | python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get("setup_required") else 1)' 2>/dev/null
}

lan_address() {
    if [[ $ROLE == gateway && -n $LAN_SUBNET ]]; then echo "${LAN_SUBNET%/*}"; return; fi
    hostname -I 2>/dev/null | awk '{print $1}'
}

finish_info() {   # -> FIN_HOST FIN_URL FIN_FPR
    FIN_HOST="$(lan_address)"
    FIN_URL="http://$FIN_HOST/"
    [[ "$(/usr/local/sbin/tuxwall-tls decide 2>/dev/null)" == active ]] && FIN_URL="https://$FIN_HOST/"
    FIN_FPR="$(/usr/local/sbin/tuxwall-tls status --json 2>/dev/null | python3 -c 'import json,sys; print((json.load(sys.stdin).get("ca") or {}).get("fingerprint_sha256",""))' 2>/dev/null)"
}

# The login screen keeps the result (agetty prints /etc/issue.d/*.issue;
# backslashes would be agetty escapes, so none are written).
write_issue() {
    [[ -n ${FIN_URL:-} ]] || finish_info
    mkdir -p "${ISSUE%/*}" 2>/dev/null || return 0
    {
        printf 'TuxWall dashboard: %s\n' "$FIN_URL"
        [[ $FIN_URL == https://* && -n $FIN_FPR ]] && printf 'Router CA SHA-256: %s\n' "$FIN_FPR"
        [[ $FIN_URL == https://* ]] && printf 'Router CA: http://%s/tuxwall-ca.crt (compare the fingerprint)\n' "$FIN_HOST"
        printf 'Re-run the setup: sudo tuxwall-setup\n\n'
    } | tr -d '\\' >"$ISSUE.tmp" && chmod 644 "$ISSUE.tmp" && mv -f "$ISSUE.tmp" "$ISSUE"
    log "login screen: $ISSUE"
}

finish_text() {
    local host url fpr admin_line
    [[ -n ${FIN_URL:-} ]] || finish_info
    host=$FIN_HOST url=$FIN_URL fpr=$FIN_FPR
    if [[ -n $ADMIN_USER ]] && ! setup_required; then
        admin_line="Log in as '$ADMIN_USER'."
    else
        admin_line="Open the dashboard now and create the administrator account
(the first visitor creates it)."
    fi
    printf 'TuxWall is installed.\n\n'
    printf 'Dashboard:   %s\n' "$url"
    if [[ $url == https://* ]]; then
        printf 'Router CA:   http://%s/tuxwall-ca.crt\n' "$host"
        [[ -n $fpr ]] && printf 'CA SHA-256:  %s\n' "$fpr"
        printf '             (compare it before trusting the certificate)\n'
    fi
    printf '\n%s\n' "$admin_line"
    [[ $ROLE == gateway ]] && printf '\nConnect a computer to %s: it gets an address by DHCP.\nSSH: ssh <user>@%s (from the LAN)\n' "$LAN" "$host"
    printf 'Re-run this setup: sudo tuxwall-setup\n'
}

disarm() {   # setup finished (or "don't ask again"): no more first-boot runs
    rm -f "$PENDING" "$HINT"
    local l
    for l in /etc/systemd/system/*.wants/tuxwall-setup@*.service; do
        [[ -L $l ]] && rm -f "$l"
    done
    systemctl daemon-reload >/dev/null 2>&1 || true
    log "first-boot setup disarmed: $1"
}

drop_password_file() {   # only a file under /etc/tuxwall/ (written for this setup)
    [[ -n $ADMIN_PASSWORD_FILE && $ADMIN_PASSWORD_FILE == /etc/tuxwall/* && -f $ADMIN_PASSWORD_FILE ]] || return 0
    rm -f "$ADMIN_PASSWORD_FILE" && log "removed the used password file $ADMIN_PASSWORD_FILE"
}

mark_done() {
    mkdir -p /etc/tuxwall
    {
        printf 'completed=%s\n' "$(date -u '+%FT%TZ')"
        printf 'role=%s\nwan=%s\nwan_mode=%s\nlan=%s\nlan_subnet=%s\n' "$ROLE" "$WAN" "$WAN_MODE" "$LAN" "$LAN_SUBNET"
    } >"$DONE_FILE"
    disarm "completed"
}

failure_menu() {   # -> 0 retry, 1 change answers, 2 quit
    local c tailtxt
    tailtxt="$(tail -n 8 "$INSTALL_LOG" 2>/dev/null | cut -c1-74)"
    ui_menu c "Installation failed" \
"The installer stopped with an error. Nothing is locked: SSH and this
console keep working. Full log: $INSTALL_LOG

$tailtxt" retry \
        retry  "Run the installer again" \
        change "Change the answers" \
        quit   "Quit (fix it, then run sudo tuxwall-setup)" || return 2
    case "$c" in retry) return 0 ;; change) return 1 ;; *) return 2 ;; esac
}

###############################################################################
#  Modes
###############################################################################
pick_ui() {
    [[ -n $UI ]] && return 0
    local t; t="$(tty 2>/dev/null || true)"
    if [[ -z $TERM || $TERM == dumb || $t == /dev/ttyS* || $t == /dev/ttyAMA* || $t == /dev/hvc* || $t == /dev/ttyUSB* ]] \
       || ! command -v whiptail >/dev/null 2>&1; then
        UI=plain
    else
        UI=tui
    fi
}

console_gate() {   # first-boot unit: wait for Enter on this console
    case "$CONSOLE_TTY" in
        tty[0-9]*) export TERM=linux ;;
        *) [[ -z ${TERM:-} || $TERM == dumb ]] && export TERM=vt220 ;;
    esac
    stty sane 2>/dev/null || true
    local a shown=0
    while true; do
        [[ -e $PENDING ]] || exit 0
        if [[ -s $AUTO_ANSWERS ]]; then
            # Unattended: one console runs it, the others wait for it to end.
            if flock -n 8; then
                [[ -e $PENDING ]] || exit 0
                ANSWERS=$AUTO_ANSWERS AUTO_RUN=1
                printf '\n  TuxWall setup: running unattended with %s\n\n' "$AUTO_ANSWERS"
                return 0
            fi
            printf '\n  TuxWall setup is running unattended on another console.\n'
            flock 8
            exit 0
        fi
        if (( ! shown )); then
            # boot messages above the prompt: start from a clean screen
            [[ $CONSOLE_TTY == tty[0-9]* ]] && printf '\033[H\033[2J'
            printf '\n\n  TuxWall setup\n  =============\n\n'
            printf '  This machine is not set up as a TuxWall router yet.\n\n'
            printf '  Press Enter to start the setup on this console,\n'
            printf '  or type "skip" + Enter to get a normal login prompt\n'
            printf '  (run "sudo tuxwall-setup" later; it asks again at the next boot).\n\n'
            shown=1
        fi
        if read -r -t 5 a; then
            [[ ${a,,} == skip ]] && exit 0
            [[ -s $AUTO_ANSWERS ]] && continue
            if ! flock -n 8; then
                printf '  The setup is already running on another console or SSH session.\n'
                shown=0; sleep 5; continue
            fi
            return 0
        fi
    done
}

wizard() {   # interactive flow; rc 0 installed, 2 postponed/quit
    local rc s
    step_welcome; rc=$?; (( rc == 0 )) || return 2
    step_role; rc=$?; (( rc == 2 )) && return 2
    while true; do
        s=wan
        while [[ $s != go ]]; do
            case "$s" in
                wan)
                    if [[ $ROLE == dashboard ]]; then s=net
                    elif step_wan; then s=mode
                    else return 2; fi ;;
                mode)
                    if step_wan_mode; then s=net; else s=wan; fi ;;
                net)
                    if step_internet; then s=lan
                    elif [[ $ROLE == dashboard ]]; then return 2
                    else s=mode; fi ;;
                lan)
                    if [[ $ROLE == dashboard ]]; then s=acct
                    elif step_lan; then s=subnet
                    else s=mode; fi ;;
                subnet)
                    if step_subnet; then s=acct; else s=lan; fi ;;
                acct)
                    if step_admin; then s=review; else s=subnet; fi ;;
                review)
                    local msg
                    if ! msg="$(check_answers)"; then
                        ui_msg "Check the answers" "$msg"; s=wan
                    elif ui_yesno "Review" "$(summary_text)

Install TuxWall with these settings?" "Install" "Change"; then
                        s=go
                    else
                        s=wan
                    fi ;;
            esac
        done
        while true; do
            if run_install; then
                local out=""
                if [[ -n $ADMIN_USER ]] && ! out="$(create_admin)"; then
                    ui_msg "Administrator not created" "The dashboard did not accept the account: ${out:-no answer}
Create it in the browser instead (first visit)."
                fi
                mark_done
                finish_info
                write_issue
                local txt; txt="$(finish_text)"
                log "finished: ${txt//$'\n'/ | }"
                ui_msg "TuxWall is ready" "$txt

(This also stays on the console's login screen.)"
                return 0
            fi
            failure_menu; rc=$?
            case "$rc" in 0) continue ;; 1) break ;; *) return 2 ;; esac
        done
    done
}

main() {
    parse_args "$@"
    # Started by tuxwall-setup@.service: nothing to do once the setup is done
    # (the unit then gives the console straight back to its getty).
    [[ ${TUXWALL_SETUP_FIRSTBOOT:-} == 1 && ! -e $PENDING ]] && exit 0
    detect_phys
    if (( LIST_ONLY )); then nic_table; exit 0; fi

    if (( PRINT_ONLY )); then
        find_installer || die "tuxwall-install.sh not found (--installer PATH)"
        read_answers "$ANSWERS"
        local msg; msg="$(check_answers)" || die "$msg"
        build_install_cmd
        printf '%q ' "${INSTALL_CMD[@]}"; printf '\n'
        exit 0
    fi

    [[ $EUID -eq 0 ]] || die "run as root: sudo tuxwall-setup"
    (( FIXTURE )) && die "TUXWALL_SETUP_SYSNET is a test hook; it only works with --print-command / --list-nics"
    mkdir -p /etc/tuxwall
    touch "$LOG" && chmod 600 "$LOG"
    exec 8>"$LOCK"
    if [[ -n $CONSOLE_TTY ]]; then
        console_gate
    elif ! flock -n 8; then
        die "the setup is already running (another console or SSH session)"
    fi
    log "start (console=${CONSOLE_TTY:-none} answers=${ANSWERS:+yes})"

    if ! find_installer; then
        die "tuxwall-install.sh not found (looked in ${INSTALLER_PATHS[*]}); download it from the TuxWall release and pass --installer PATH"
    fi

    if [[ -n $ANSWERS ]]; then
        read_answers "$ANSWERS"
        local msg; msg="$(check_answers)" || die "$msg"
        say "TuxWall setup (answers file): $(summary_text | tr '\n' ';')"
        prepare_wan || say "warning: internet check failed; trying the install anyway"
        if ! run_install; then
            say "installer failed; log: $INSTALL_LOG"
            exit 1
        fi
        if [[ -n $ADMIN_USER ]]; then create_admin >/dev/null || say "warning: administrator not created"; fi
        mark_done
        finish_info
        write_issue
        # answers dropped in by cloud-init / an image: the password file has served
        (( AUTO_RUN )) && drop_password_file
        finish_text | tee -a "$LOG"
        [[ -n $CONSOLE_TTY ]] && printf '\n(This summary stays on the login screen.)\n' && sleep 5
        exit 0
    fi

    pick_ui
    links_up
    wizard; local rc=$?
    if (( rc != 0 )); then
        [[ $UI == tui ]] && clear
        say "TuxWall setup not completed. Run it again any time: sudo tuxwall-setup"
        [[ -n $CONSOLE_TTY ]] && sleep 2
    fi
    exit 0
}

# Sourcing (tools/netinstall_check.py drives the prompts with a fixture) defines
# the functions only.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
