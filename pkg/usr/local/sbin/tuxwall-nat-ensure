#!/bin/sh
# tuxwall-nat-ensure — idempotent LAN->WAN masquerade (product version).
#
# Owns the general POSTROUTING MASQUERADE rule. This replaces NAT stanzas in
# /etc/ufw/before.rules, which ufw reload APPENDS duplicates of instead of
# replacing (verified 2026-11-05 in the field: six duplicate MASQUERADE
# rules had accumulated across a week of reloads). Safe to run any number
# of times: it checks with -C before adding.
#
# The WAN interface is auto-detected from the default route; override with
# TUXWALL_WAN_IFACE for exotic setups (bonded WAN, pppoe, etc.).
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

WAN="${TUXWALL_WAN_IFACE:-$(ip route show default 2>/dev/null | head -1 | awk '{print $5; exit}')}"
[ -n "$WAN" ] || exit 0

iptables -t nat -C POSTROUTING -o "$WAN" -j MASQUERADE 2>/dev/null || \
  iptables -t nat -A POSTROUTING -o "$WAN" -j MASQUERADE

exit 0
