:root {
  --bg: #0f1419;
  --bg-elev: #161b22;
  --card: #1c2333;
  --border: #2d333b;
  --text: #e6edf3;
  --muted: #8b949e;
  --accent: #4f8cff;
  --green: #3fb950;
  --red: #f85149;
  --amber: #d29922;
  --radius: 10px;
  --font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue",
    Arial, sans-serif;
  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}

* { box-sizing: border-box; }

html, body { height: 100%; }

body {
  margin: 0;
  font-family: var(--font);
  font-size: 14px;
  color: var(--text);
  background: var(--bg);
}

.muted { color: var(--muted); }
.mono { font-family: var(--mono); font-size: 13px; }

/* ---------- Layout ---------- */
.layout { display: flex; min-height: 100vh; }

/* ---------- Sidebar ---------- */
.sidebar {
  width: 220px;
  flex-shrink: 0;
  background: var(--bg-elev);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  position: sticky;
  top: 0;
  height: 100vh;
  padding: 10px 12px;
}

.brand { display: flex; align-items: center; gap: 10px; padding: 2px 8px 8px; }
.brand-mark {
  width: 60px; height: 60px;
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 18px;
  overflow: hidden;
}
.brand-mark-img { width: 100%; height: 100%; object-fit: cover; display: block; }
.brand-mark svg { width: 22px; height: 22px; fill: #fff; }
.brand-name { font-weight: 700; font-size: 15px; }
.brand-sub { color: var(--muted); font-size: 12px; }

.nav { display: flex; flex-direction: column; gap: 1px; flex: 1; min-height: 0; overflow-y: auto; }
.nav-item {
  display: flex; align-items: center; gap: 10px;
  padding: 6px 10px;
  border-radius: 8px;
  color: var(--muted);
  text-decoration: none;
  cursor: pointer;
  border: 1px solid transparent;
  user-select: none;
}
.nav-item svg { width: 17px; height: 17px; fill: currentColor; flex-shrink: 0; }
.nav-item:hover { background: rgba(255, 255, 255, 0.04); color: var(--text); }
.nav-item.active {
  background: rgba(79, 140, 255, 0.12);
  color: var(--accent);
  border-color: rgba(79, 140, 255, 0.3);
}

.sidebar-foot { border-top: 1px solid var(--border); padding-top: 8px; flex-shrink: 0; }
.svc-label { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 5px; padding: 0 8px; }
.svc {
  display: flex; align-items: center; gap: 8px;
  padding: 3px 8px; color: var(--muted); font-size: 12px;
}

/* ---------- Dots ---------- */
.dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: #484f58; flex-shrink: 0;
}
.dot-ok { background: var(--green); box-shadow: 0 0 6px rgba(63, 185, 80, 0.5); }
.dot-err { background: var(--red); box-shadow: 0 0 6px rgba(248, 81, 73, 0.5); }
.dot-warn { background: var(--amber); }
.dot-off { background: #4a515b; }

.os-icon { margin: 0 6px 0 2px; }
.os-icon img { width: 16px; height: 16px; vertical-align: -3px; }

/* ---------- Main ---------- */
.main { flex: 1; padding: 20px 28px 40px; max-width: 1200px; }

.topbar {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16px; flex-wrap: wrap; margin-bottom: 18px;
}
.topbar h1 { font-size: 22px; margin: 0; }
.topbar-actions { display: flex; align-items: center; gap: 14px; }

.btn {
  background: var(--accent); color: #fff; border: none;
  padding: 8px 16px; border-radius: 7px;
  font-size: 13px; font-weight: 600; cursor: pointer;
}
.btn:hover { filter: brightness(1.1); }

.seg-btns { display: inline-flex; gap: 2px; background: rgba(255,255,255,0.05); padding: 3px; border-radius: 8px; }
.seg-btn {
  background: transparent; color: var(--muted); border: none;
  padding: 5px 14px; border-radius: 6px; font-size: 12px;
  font-weight: 600; cursor: pointer; line-height: 1.4;
}
.seg-btn:hover { color: var(--text); }
.seg-btn.active { background: var(--accent); color: #fff; }
.seg-btn .seg-count { opacity: 0.75; font-weight: 500; margin-left: 5px; }

.toggle { display: flex; align-items: center; gap: 7px; color: var(--muted); cursor: pointer; font-size: 13px; }
.toggle input { display: none; }
.toggle-track {
  width: 34px; height: 18px; border-radius: 10px;
  background: #30363d; position: relative; transition: background 0.2s;
}
.toggle-track::after {
  content: ""; position: absolute; top: 2px; left: 2px;
  width: 14px; height: 14px; border-radius: 50%;
  background: #fff; transition: transform 0.2s;
}
.toggle input:checked + .toggle-track { background: var(--accent); }
.toggle input:checked + .toggle-track::after { transform: translateX(16px); }

.banner {
  background: rgba(248, 81, 73, 0.12);
  border: 1px solid rgba(248, 81, 73, 0.4);
  color: #ffb4ae;
  padding: 10px 14px; border-radius: var(--radius);
  margin-bottom: 16px; font-size: 13px;
}

/* ---------- Stats ---------- */
.stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; margin-bottom: 18px; }
.stat-card {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 16px;
}
.stat-value { font-size: 22px; font-weight: 700; }
.stat-label { color: var(--muted); font-size: 12.5px; margin-top: 2px; }

/* Pi-hole style: each overview stat card gets its own accent */
.stat-card.stat-c { position: relative; overflow: hidden; }
.host-edit {
  position: absolute; top: 10px; right: 10px; z-index: 1;
  width: 28px; height: 28px;
  display: flex; align-items: center; justify-content: center;
  background: transparent; border: 1px solid transparent; border-radius: 6px;
  color: var(--muted); cursor: pointer;
}
.host-edit svg { width: 15px; height: 15px; fill: currentColor; }
.host-edit:hover { color: var(--stat-c); background: var(--bg-elev); border-color: var(--border); }
.host-editor { display: flex; align-items: center; gap: 6px; }
.host-editor input {
  flex: 1; min-width: 0; width: 100%;
  background: var(--bg); border: 1px solid var(--accent); border-radius: 6px;
  color: var(--fg); font: inherit; font-size: 14px; padding: 4px 8px;
}
.host-editor .host-save,
.host-editor .host-cancel {
  flex-shrink: 0;
  background: var(--bg-elev); border: 1px solid var(--border); color: var(--fg);
  border-radius: 6px; font-size: 12px; padding: 4px 8px; cursor: pointer;
}
.host-editor .host-save:hover { border-color: var(--accent); color: var(--accent); }
.host-editor .host-cancel:hover { border-color: var(--red); color: var(--red); }
.stat-card.stat-c::before {
  content: "";
  position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background: var(--stat-c, var(--accent));
}
.stat-card.stat-c .stat-value { color: var(--stat-c); }
.stat-c-amber { --stat-c: #d29922; }
.stat-c-blue { --stat-c: #4f8cff; }
.stat-c-green { --stat-c: #3fb950; }
.stat-c-purple { --stat-c: #bc8cff; }
.stat-c-teal { --stat-c: #39c5cf; }
.stat-c-red { --stat-c: #f85149; }
.stat-c-orange { --stat-c: #ffa657; }
.stat-c-pink { --stat-c: #db61a2; }
.stat-reset {
  position: absolute; top: 10px; right: 10px; z-index: 1;
  width: 24px; height: 24px; line-height: 24px;
  display: flex; align-items: center; justify-content: center;
  background: transparent; border: 1px solid transparent; border-radius: 6px;
  color: var(--muted); cursor: pointer; font-size: 14px; padding: 0;
}
.stat-reset:hover { color: var(--stat-c); background: var(--bg-elev); border-color: var(--border); }

/* ---------- Card / table ---------- */
.card {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius); overflow: hidden;
}
.view > .card { margin-top: 18px; }
.view > .card-grid > .card { margin-bottom: 0; }
.view[hidden] { display: none !important; }
.card-toolbar {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 14px; border-bottom: 1px solid var(--border);
  flex-wrap: wrap;
}
.card-toolbar input[type="search"] {
  flex: 1; min-width: 220px;
  background: var(--bg-elev); border: 1px solid var(--border);
  color: var(--text); border-radius: 7px; padding: 8px 12px;
  font-size: 13px; font-family: inherit; outline: none;
}
.card-toolbar input[type="search"]:focus { border-color: var(--accent); }

.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; }
thead th {
  text-align: left; padding: 10px 14px;
  color: var(--muted); font-size: 12px; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.05em;
  border-bottom: 1px solid var(--border);
  background: rgba(0, 0, 0, 0.15);
  white-space: nowrap;
}
th.sortable { cursor: pointer; user-select: none; }
th.sortable:hover { color: var(--text); }
th.sortable .sort-mark { margin-left: 4px; opacity: 0.5; }
th.sorting-asc .sort-mark::after { content: " ▲"; opacity: 1; }
th.sorting-desc .sort-mark::after { content: " ▼"; opacity: 1; }
tbody td {
  padding: 9px 14px; border-bottom: 1px solid var(--border);
  white-space: nowrap;
}
tbody tr:last-child td { border-bottom: none; }
tbody tr:hover { background: rgba(255, 255, 255, 0.03); }

.badge {
  display: inline-block; padding: 2px 9px; border-radius: 20px;
  background: rgba(79, 140, 255, 0.15); color: var(--accent);
  font-size: 12px; font-weight: 600;
}

.badge-ok { background: rgba(63, 185, 80, 0.15); color: var(--green); }
.badge-err { background: rgba(248, 81, 73, 0.15); color: var(--red); }
.badge-static { background: rgba(147, 158, 184, 0.18); color: #9aa5bd; }

.sev-HIGH { background: rgba(248, 81, 73, 0.15); color: var(--red); }
.sev-MEDIUM { background: rgba(227, 179, 65, 0.15); color: #e3b341; }
.sev-LOW { background: rgba(63, 185, 80, 0.15); color: var(--green); }

.bar-fill-err { background: var(--red); }

.card-mt { margin-top: 18px; }
.card-wide { grid-column: 1 / -1; }
.td-right { text-align: right; }
.bk-upload { padding: 14px; }
.bk-upload-row { display: flex; align-items: center; gap: 10px; margin: 10px 0; flex-wrap: wrap; }
.bk-upload-row input[type="file"] { flex: 1; min-width: 200px; color: var(--muted); font-size: 13px; }
.bk-msg-ok { color: var(--green); }
.bk-msg-err { color: var(--red); }

.empty { padding: 40px; text-align: center; color: var(--muted); }

/* Overview: let Top Talkers / Suricata Alerts tables wrap so long
   signatures and hostnames fit the narrow column without an inner scrollbar. */
#ov-talkers-body td,
#ov-suricata-body td { white-space: normal; word-break: break-word; }
#ov-talkers-body td:first-child,
#ov-suricata-body td:first-child { min-width: 0; }
#ov-suricata-body td:last-child,
#ov-talkers-body td:last-child { white-space: nowrap; }

/* ---------- DNS page ---------- */
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 14px;
  margin-top: 18px;
}
.card-head {
  display: flex; align-items: center; justify-content: space-between; gap: 10px;
  padding: 12px 14px; border-bottom: 1px solid var(--border);
  flex-wrap: wrap;
}
.card-head h2 { margin: 0; font-size: 14px; }
.card-edit {
  margin-left: auto; flex-shrink: 0;
  width: 28px; height: 28px;
  display: flex; align-items: center; justify-content: center;
  background: transparent; border: 1px solid transparent; border-radius: 6px;
  color: var(--muted); cursor: pointer;
}
.card-edit svg { width: 15px; height: 15px; fill: currentColor; }
.card-edit:hover { color: var(--accent); background: var(--bg-elev); border-color: var(--border); }
.cfg-box { max-width: 720px; }
.cfg-text { min-height: 300px; font-size: 12px; line-height: 1.5; white-space: pre; }
.cfg-hint { margin: 10px 0 0; font-size: 12px; word-break: break-all; }
.cfg-hint-ok { color: var(--green); }
.cfg-hint-err { color: var(--red); }
.upd-body { padding: 14px; }
.upd-meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; }
.upd-actions { display: flex; gap: 10px; margin-top: 14px; flex-wrap: wrap; }
.upd-progress { margin-top: 14px; }
.upd-bar { height: 14px; }
.upd-bar .bar-fill { transition: width 0.5s ease; }
.upd-status { margin: 8px 0 0; font-size: 12px; }
.upd-log {
  margin: 8px 0 0; max-height: 200px; overflow-y: auto;
  background: var(--bg-elev); border: 1px solid var(--border); border-radius: 6px;
  padding: 8px 10px; font-family: var(--mono); font-size: 11px; line-height: 1.5;
  white-space: pre-wrap; word-break: break-word; color: var(--muted);
}
.upd-hint { margin: 12px 0 0; font-size: 12px; }
.card-toolbar { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.log-ctl { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); }
.log-ctl select, .log-ctl input[type="checkbox"] { accent-color: var(--accent); }
.log-ctl select {
  background: var(--bg-elev); color: var(--fg); border: 1px solid var(--border);
  border-radius: 6px; padding: 4px 6px; font-size: 12px;
}
.log-follow { margin-left: 2px; }
.log-view {
  margin: 0; max-height: 68vh; overflow-y: auto;
  background: var(--bg-elev); border: 1px solid var(--border); border-radius: 8px;
  padding: 12px 14px; font-family: var(--mono); font-size: 11.5px; line-height: 1.5;
  white-space: pre-wrap; word-break: break-word; color: var(--muted);
}
.log-meta { margin: 10px 0 0; font-size: 12px; }

.bar { width: 100%; min-width: 60px; background: var(--bg-elev); border-radius: 4px; height: 6px; }
.bar-fill { height: 100%; background: var(--accent); border-radius: 4px; }

.cache-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
.cache-item {
  padding: 12px 14px; display: flex; flex-direction: column; gap: 3px;
  border-bottom: 1px solid var(--border);
}
.cache-item:nth-child(even) { border-left: 1px solid var(--border); }
.cache-item span { color: var(--muted); font-size: 12px; }
.cache-item b { font-size: 15px; }

/* ---------- Bandwidth ---------- */
.bw-card { margin-top: 18px; }
.bw-head {
  display: flex; align-items: center; justify-content: space-between; gap: 14px;
  padding: 12px 14px; border-bottom: 1px solid var(--border); flex-wrap: wrap;
}
.bw-head h2 { margin: 0; font-size: 14px; }
.bw-rates { display: flex; gap: 16px; font-size: 13px; }
.bw-rates .bw-dn b { color: var(--accent); }
.bw-rates .bw-up b { color: var(--amber); }
.bw-rates span { color: var(--muted); margin-right: 6px; font-size: 12px; }
.bw-canvas-wrap { padding: 10px 12px 6px; }
.bw-canvas { display: block; width: 100%; height: 180px; }
.bw-hint { padding: 10px 14px; font-size: 12px; }

/* ---------- Coming soon ---------- */
.soon { padding: 60px 30px; text-align: center; margin-top: 8px; }
.soon-icon {
  width: 48px; height: 48px; margin: 0 auto 14px;
  border-radius: 50%; border: 2px dashed var(--border);
  display: flex; align-items: center; justify-content: center;
  color: var(--muted); font-size: 24px;
}
.soon h2 { margin: 0 0 6px; font-size: 18px; }
.soon p { margin: 0; color: var(--muted); }

/* ---------- Blocklists ---------- */
.toolbar-spacer { flex: 1; }
.card-toolbar input[type="text"] {
  flex: 1; min-width: 260px;
  background: var(--bg-elev); border: 1px solid var(--border);
  color: var(--text); border-radius: 7px; padding: 8px 12px;
  font-size: 13px; font-family: inherit; outline: none;
}
.card-toolbar input[type="text"]:focus { border-color: var(--accent); }
/* Firewall add-rule form: compact structured fields */
.fw-form input[type="text"] {
  flex: 0 1 150px; min-width: 90px;
}
.fw-form select {
  flex: 0 1 auto;
  background: var(--bg-elev); border: 1px solid var(--border);
  color: var(--text); border-radius: 7px; padding: 8px 10px;
  font-size: 13px; font-family: inherit; outline: none;
}
.fw-form select:focus { border-color: var(--accent); }
.btn-sm { padding: 5px 10px; font-size: 12px; }
.btn-danger { background: var(--red); }
table .btn { margin-left: 8px; }
.btn[disabled] { opacity: 0.5; cursor: not-allowed; filter: none; }

/* Top Attackers: keep the Ban/Unban button fully visible in the narrow
   grid card instead of being clipped at the box edge. */
#sec-ips-table th,
#sec-ips-table td {
  padding-left: 10px;
  padding-right: 10px;
}
#sec-ips-table td:nth-child(2) {
  max-width: 150px;
  overflow: hidden;
  text-overflow: ellipsis;
}
#sec-ips-table .bar { min-width: 36px; }
#sec-ips-table .sec-ban,
#sec-ips-table .sec-unban {
  margin-left: 0;
  line-height: 1.4;
  white-space: nowrap;
}
.bl-log {
  margin: 0; padding: 12px 14px;
  font-family: var(--mono); font-size: 12px; line-height: 1.6;
  color: var(--muted); white-space: pre-wrap; word-break: break-all;
  max-height: 220px; overflow-y: auto;
}
.bl-note { padding: 12px 2px; font-size: 12px; }

/* ---------- Security ---------- */
.sec-map {
  height: 480px;
  width: 100%;
  position: relative;
  z-index: 0;
  background: #0b0f14;
}
.sec-map .leaflet-container { background: #0b0f14; font-family: var(--font); }
.sec-map .leaflet-control-zoom a { color: var(--text); }
.sec-note { padding: 8px 14px 12px; font-size: 12px; margin: 0; }

/* Radware-style dark attack map */
.sec-map .leaflet-tile-pane { filter: saturate(0.55) brightness(0.95); }
.sec-arcs {
  position: absolute; left: 0; top: 0; z-index: 450;
  pointer-events: none; overflow: visible;
}
.sec-arc-glow { fill: none; stroke: rgba(248, 81, 73, 0.18); }
.sec-arc-head {
  fill: none; stroke: #ff4d5e; stroke-linecap: round;
  animation: sec-arc-fly linear infinite;
  filter: drop-shadow(0 0 3px rgba(255, 77, 94, 0.9));
}
@keyframes sec-arc-fly {
  to { stroke-dashoffset: var(--len, -400); }
}
.sec-pulse-wrap.leaflet-div-icon { background: transparent; border: none; }
.sec-pulse {
  display: block; border-radius: 50%;
  background: radial-gradient(circle, rgba(248, 81, 73, 0.95) 0%, rgba(248, 81, 73, 0.35) 55%, rgba(248, 81, 73, 0) 72%);
  box-shadow: 0 0 10px rgba(248, 81, 73, 0.8);
  animation: sec-pulse-ring 2s ease-out infinite;
}
@keyframes sec-pulse-ring {
  0% { transform: scale(0.55); opacity: 0.95; }
  70% { transform: scale(2); opacity: 0.3; }
  100% { transform: scale(2.4); opacity: 0; }
}
.sec-target-wrap.leaflet-div-icon { background: transparent; border: none; }
.sec-target { position: relative; width: 28px; height: 28px; }
.sec-target-core {
  position: absolute; inset: 9px; border-radius: 50%;
  background: #ff4d5e;
  box-shadow: 0 0 12px 3px rgba(255, 77, 94, 0.85);
  animation: sec-pulse-ring 2.2s ease-out infinite;
}

/* ---------- WireGuard ---------- */
.wg-form { padding: 14px; }
.wg-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 12px; margin-bottom: 14px;
}
.wg-grid label { display: flex; flex-direction: column; gap: 5px; font-size: 12.5px; color: var(--muted); }
.wg-grid input {
  background: var(--bg-elev); border: 1px solid var(--border); color: var(--text);
  border-radius: 7px; padding: 8px 12px; font-size: 13px; font-family: var(--mono); outline: none;
}
.wg-grid input:focus { border-color: var(--accent); }
.wg-form .btn { margin-right: 10px; }

.modal {
  position: fixed; inset: 0; z-index: 1000;
  background: rgba(0, 0, 0, 0.65);
  display: flex; align-items: center; justify-content: center; padding: 20px;
}
.modal[hidden] { display: none !important; }
.modal-box {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 22px; max-width: 460px; width: 100%;
  max-height: 92vh; overflow-y: auto; position: relative;
}
.modal-close {
  position: absolute; top: 8px; right: 12px; background: none; border: none;
  color: var(--muted); font-size: 26px; cursor: pointer; line-height: 1;
}
.modal-box h3 { margin: 0 0 14px; font-size: 16px; }
.wg-qr-wrap { display: flex; justify-content: center; margin-bottom: 14px; }
.wg-qr { width: 240px; height: 240px; image-rendering: pixelated; }
.wg-conf {
  width: 100%; background: var(--bg-elev); border: 1px solid var(--border);
  color: var(--text); border-radius: 7px; padding: 10px 12px;
  font-family: var(--mono); font-size: 11.5px; resize: none; box-sizing: border-box;
}
.wg-modal-actions { display: flex; gap: 10px; margin-top: 14px; }
.wg-actions { display: flex; gap: 6px; justify-content: flex-end; }
.wg-actions .btn { margin-left: 0; }
.peer-up { color: var(--green, #3fb950); }
.muted-err { color: var(--red); }
.text-err { color: var(--red); font-size: 13px; }

/* AI threat summary panel */
.ai-summary {
  border: 1px solid var(--border);
  background: var(--bg-elev);
  border-radius: 9px;
  padding: 14px 16px;
  font-size: 13.5px;
  line-height: 1.55;
  margin: 10px 0 6px;
}
.ai-summary .ai-li {
  padding-left: 14px;
  position: relative;
  margin-top: 5px;
}
.ai-summary .ai-li::before {
  content: "\2022";
  position: absolute;
  left: 0;
  color: var(--accent, #58a6ff);
}
.ai-model-select {
  background: var(--bg-elev); border: 1px solid var(--border);
  color: var(--text); border-radius: 7px; padding: 8px 10px;
  font-size: 13px; font-family: inherit; outline: none;
}
.ai-model-select:focus { border-color: var(--accent); }
.ai-summary .ai-top {
  margin-top: 8px;
  font-weight: 600;
  color: var(--accent, #58a6ff);
}
.ai-cmd-label {
  margin-top: 12px;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--muted);
}
.ai-cmd {
  margin: 10px 0 2px;
  padding: 10px 12px;
  background: var(--bg, #0d1117);
  border: 1px solid var(--border);
  border-left: 3px solid var(--green, #3fb950);
  border-radius: 7px;
  font-family: var(--mono);
  font-size: 12.5px;
  line-height: 1.6;
  overflow-x: auto;
  white-space: pre;
}
.ai-cfg-label {
  display: block;
  margin: 12px 0 4px;
  font-size: 12px;
  font-weight: 600;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.ai-cfg-input {
  width: 100%;
  padding: 8px 10px;
  background: var(--bg-elev);
  border: 1px solid var(--border);
  border-radius: 7px;
  color: var(--text);
  font-size: 13px;
  font-family: var(--mono);
  outline: none;
  box-sizing: border-box;
}
.ai-cfg-input:focus { border-color: var(--accent); }

/* ---------- Overview ---------- */
#view-overview {
  display: flex;
  flex-direction: column;
  min-height: calc(100vh - 140px);
}
.chart-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
  gap: 14px;
  margin-top: 18px;
}
.chart-grid-map {
  grid-template-columns: minmax(0, 1fr);
  grid-template-rows: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
  align-items: stretch;
  flex: 1 1 auto;
  min-height: 420px;
}
.chart-grid-map > .card { display: flex; flex-direction: column; min-height: 0; }
.chart-grid-map > .card > .card-head { flex-shrink: 0; }
.chart-grid-map .table-wrap { flex: 1 1 auto; overflow-x: hidden; }
.pie-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 14px;
  margin-top: 18px;
  flex-shrink: 0;
}
.pie-wrap { padding: 10px 12px 6px; }
.pie-canvas { display: block; width: 100%; height: 220px; }
.pie-canvas:hover { cursor: crosshair; }
.pie-tip {
  position: fixed; z-index: 1200; pointer-events: none;
  display: none; max-width: 280px;
  background: #0d1117; border: 1px solid var(--border);
  border-radius: 8px; padding: 8px 11px;
  font-size: 12px; line-height: 1.5;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  color: var(--text);
}
.pie-tip-dot {
  display: inline-block; width: 9px; height: 9px;
  border-radius: 2px; margin-right: 7px;
}
.pie-tip b { margin-right: 8px; }
.pie-tip-val { color: var(--muted); }
.stack { display: flex; flex-direction: column; gap: 14px; min-height: 0; }
.stack > .card {
  flex: 1 1 0;
  display: flex; flex-direction: column; min-height: 0;
}
.stack > .card > .table-wrap { flex: 1 1 auto; min-height: 0; }
.ov-map { flex: 1 1 auto; min-height: 420px; width: 100%; }

/* ---------- Responsive ---------- */
@media (max-width: 760px) {
  .layout { flex-direction: column; }
  .sidebar {
    width: 100%; height: auto; position: static;
    flex-direction: row; align-items: center; flex-wrap: wrap;
    gap: 10px;
  }
  .nav { flex-direction: row; flex-wrap: wrap; flex: 1; }
  .sidebar-foot { display: none; }
  .main { padding: 16px; }
}
