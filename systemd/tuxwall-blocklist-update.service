[Unit]
Description=Tuxwall blocklist daily update trigger
After=network-online.target tuxwall.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'curl --fail --silent --show-error -X POST -H "X-Tuxwall-Token: $(cat /etc/tuxwall/internal-token)" http://127.0.0.1:8008/api/blocklists/update'
TimeoutStartSec=60
