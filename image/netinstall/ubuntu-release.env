# Pinned Ubuntu release for the TuxWall netinstall ISO (KEY=VALUE, read by
# build.sh and tools/netinstall_check.py; never sourced).
#
# The ISO boots the kernel + initrd of exactly this live-server ISO, so the
# ISO the installer downloads must be this one (casper also checks its UUID).
# Bump all values together when Ubuntu publishes a new point release: the old
# one moves from releases.ubuntu.com to old-releases.ubuntu.com, which the GRUB
# menu offers as a fallback entry.
UBUNTU_VERSION=26.04.1
UBUNTU_CODENAME=resolute
UBUNTU_ISO=ubuntu-26.04.1-live-server-amd64.iso
UBUNTU_BASE_URL=https://releases.ubuntu.com/26.04.1
UBUNTU_OLD_BASE_URL=https://old-releases.ubuntu.com/releases/26.04.1
UBUNTU_ISO_SHA256=cc8a95cde20f6ced61a322420de00f10cc3c90ced545daa46cb9c1a117f1d927
UBUNTU_ISO_SIZE=2927861760
UBUNTU_CASPER_UUID=f65b0304-9db7-45fe-8f6e-d8e5ac88015d
# "Ubuntu CD Image Automatic Signing Key (2012) <cdimage@ubuntu.com>" - signs SHA256SUMS.gpg
UBUNTU_CDIMAGE_KEY_FPR=843938DF228D22F7B3742BC0D94AA3F0EFE21092
# TuxWall APT repository key (apt-public.asc)
TUXWALL_APT_KEY_FPR=5D79B9082DCAEB9CCB731382F5D8235716BDBDD1
