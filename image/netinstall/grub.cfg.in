# TuxWall netinstall @TUXWALL_VERSION@ - Ubuntu @UBUNTU_VERSION@ LTS server installer.
# Rendered by image/netinstall/build.sh. Used by both UEFI (Ubuntu's signed
# shim + GRUB) and BIOS (Ubuntu's GRUB El Torito image) boots.
# No auto-boot: the default entry downloads into RAM (6 GB+); on a smaller box
# an unattended boot would end in a BusyBox shell. Wait for a choice.
set timeout=-1
set timeout_style=menu
set default=0

# Menu on the screen and the first serial port (headless boxes).
if serial --unit=0 --speed=115200; then
    terminal_input console serial
    terminal_output console serial
fi

loadfont unicode

set menu_color_normal=white/black
set menu_color_highlight=black/light-gray

menuentry "Install TuxWall (downloads Ubuntu @UBUNTU_VERSION@ into RAM: needs 6 GB+ RAM)" {
    set gfxpayload=keep
    linux  /casper/vmlinuz ip=dhcp iso-url=@ISO_URL@ initramfs_options=size=90% ds=nocloud ---
    initrd /casper/initrd
}
menuentry "Install TuxWall - Ubuntu ISO written to a second USB stick (low RAM)" {
    set gfxpayload=keep
    linux  /casper/vmlinuz ds=nocloud ---
    initrd /casper/initrd
}
menuentry "Install TuxWall - Ubuntu ISO file on another USB stick / disk (low RAM)" {
    set gfxpayload=keep
    linux  /casper/vmlinuz iso-scan/filename=/@UBUNTU_ISO@ ds=nocloud ---
    initrd /casper/initrd
}
menuentry "Install TuxWall - download from old-releases.ubuntu.com (if the first entry fails)" {
    set gfxpayload=keep
    linux  /casper/vmlinuz ip=dhcp iso-url=@ISO_URL_OLD@ initramfs_options=size=90% ds=nocloud ---
    initrd /casper/initrd
}
submenu "Serial console (ttyS0, 115200 baud) ..." {
    menuentry "Install TuxWall on the serial console (download)" {
        linux  /casper/vmlinuz ip=dhcp iso-url=@ISO_URL@ initramfs_options=size=90% ds=nocloud --- console=tty0 console=ttyS0,115200n8
        initrd /casper/initrd
    }
    menuentry "Install TuxWall on the serial console (Ubuntu ISO written to a second USB stick)" {
        linux  /casper/vmlinuz ds=nocloud --- console=tty0 console=ttyS0,115200n8
        initrd /casper/initrd
    }
    menuentry "Install TuxWall on the serial console (ISO file on another USB stick / disk)" {
        linux  /casper/vmlinuz iso-scan/filename=/@UBUNTU_ISO@ ds=nocloud --- console=tty0 console=ttyS0,115200n8
        initrd /casper/initrd
    }
}
menuentry "Help: which entry? (RAM, 'No space left on device', BusyBox shell)" {
    echo ""
    echo "TuxWall netinstall @TUXWALL_VERSION@ - which menu entry?"
    echo ""
    echo "* 6 GB RAM or more, internet by DHCP on a network port:"
    echo "    'Install TuxWall (downloads Ubuntu ...)'. The 2.9 GB Ubuntu ISO is"
    echo "    downloaded into RAM. With too little RAM it stops with"
    echo "    'No space left on device' / 'Unable to find a live file system'"
    echo "    and a BusyBox (initramfs) prompt: power off and use an entry below."
    echo ""
    echo "* Less RAM (4 GB is enough): get @UBUNTU_ISO@"
    echo "    from releases.ubuntu.com and either write it to a second USB stick"
    echo "    (Rufus / balenaEtcher / dd) -> 'Ubuntu ISO written to a second USB stick',"
    echo "    or copy the .iso FILE to any other stick or disk"
    echo "    -> 'Ubuntu ISO file on another USB stick / disk'."
    echo ""
    echo "Nothing is written to a disk before you pick it in Ubuntu's installer"
    echo "and confirm. Details: https://github.com/rezzonance/tuxwall#install-from-usb-netinstaller"
    echo ""
    echo "Press Esc to return to the menu."
    sleep --interruptible 600
}
grub_platform
if [ "$grub_platform" = "efi" ]; then
menuentry 'Boot from next volume' {
    exit 1
}
menuentry 'UEFI Firmware Settings' {
    fwsetup
}
fi
