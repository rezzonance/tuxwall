# TuxWall netinstall @TUXWALL_VERSION@ - Ubuntu @UBUNTU_VERSION@ LTS server installer.
# Rendered by image/netinstall/build.sh. Used by both UEFI (Ubuntu's signed
# shim + GRUB) and BIOS (Ubuntu's GRUB El Torito image) boots.
set timeout=30
set default=0

# Menu on the screen and the first serial port (headless boxes).
if serial --unit=0 --speed=115200; then
    terminal_input console serial
    terminal_output console serial
fi

loadfont unicode

set menu_color_normal=white/black
set menu_color_highlight=black/light-gray

menuentry "Install TuxWall (downloads Ubuntu @UBUNTU_VERSION@, ~2.9 GB into RAM: 6 GB+ RAM)" {
    set gfxpayload=keep
    linux  /casper/vmlinuz ip=dhcp iso-url=@ISO_URL@ initramfs_options=size=90% ds=nocloud ---
    initrd /casper/initrd
}
menuentry "Install TuxWall - Ubuntu ISO file on another USB stick / disk (low RAM)" {
    set gfxpayload=keep
    linux  /casper/vmlinuz iso-scan/filename=/@UBUNTU_ISO@ ds=nocloud ---
    initrd /casper/initrd
}
menuentry "Install TuxWall - download from old-releases.ubuntu.com (if the first entry fails)" {
    set gfxpayload=keep
    linux  /casper/vmlinuz ip=dhcp iso-url=@ISO_URL_OLD@ initramfs_options=size=90% ds=nocloud ---
    initrd /casper/initrd
}
submenu "Serial console (ttyS0, 115200 baud) ..." {
    menuentry "Install TuxWall on the serial console (download)" {
        linux  /casper/vmlinuz ip=dhcp iso-url=@ISO_URL@ initramfs_options=size=90% ds=nocloud --- console=tty0 console=ttyS0,115200n8
        initrd /casper/initrd
    }
    menuentry "Install TuxWall on the serial console (ISO file on another USB stick / disk)" {
        linux  /casper/vmlinuz iso-scan/filename=/@UBUNTU_ISO@ ds=nocloud --- console=tty0 console=ttyS0,115200n8
        initrd /casper/initrd
    }
}
grub_platform
if [ "$grub_platform" = "efi" ]; then
menuentry 'Boot from next volume' {
    exit 1
}
menuentry 'UEFI Firmware Settings' {
    fwsetup
}
fi
