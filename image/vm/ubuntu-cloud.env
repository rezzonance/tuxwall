# Ubuntu cloud image the TuxWall VM image is built from (KEY=VALUE, read by
# image/vm/build.sh and tools/netinstall_check.py; never sourced).
#
# The dated release directories are removed from cloud-images.ubuntu.com
# after a few months: build.sh --latest uses the newest one instead (same
# signature check; the serial and SHA-256 used go into the build log and the
# image's /etc/tuxwall/vm-image). Bump SERIAL + SHA256 together.
UBUNTU_CLOUD_VERSION=26.04
UBUNTU_CLOUD_CODENAME=resolute
UBUNTU_CLOUD_BASE_URL=https://cloud-images.ubuntu.com/releases/resolute
UBUNTU_CLOUD_SERIAL=20261108
UBUNTU_CLOUD_IMAGE=ubuntu-26.04-server-cloudimg-amd64.img
UBUNTU_CLOUD_SHA256=7b90593f5532b49b7e3fe3d2743f0d1f0d822e5b07cebcd8e00c0df8069ecab9
# "UEC Image Automatic Signing Key <cdimage@ubuntu.com>" - signs the cloud
# images' SHA256SUMS.gpg (package ubuntu-cloudimage-keyring)
UBUNTU_CLOUD_KEY_FPR=D2EB44626FDDC30B513D5BB71A5D6C4C7DB87C81
# TuxWall APT repository key (apt-public.asc)
TUXWALL_APT_KEY_FPR=5D79B9082DCAEB9CCB731382F5D8235716BDBDD1
# Virtual disk size of the image (sparse; cloud-init grows the root file
# system to the disk at first boot). TuxWall + Ubuntu need ~8 GB.
VM_DISK_SIZE=16G
